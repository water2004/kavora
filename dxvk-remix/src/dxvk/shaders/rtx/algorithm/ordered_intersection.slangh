#pragma once

#include "rtx/algorithm/voxel_coverage.slangh"

RayHitInfo traceOrderedIntersection(RayDesc ray, uint flags, uint mask)
{
  RayQuery<0> query = RayQuery<0>();
  query.TraceRayInline(topLevelAS, hasVoxelCoverage() ? (flags & ~RAY_FLAG_FORCE_OPAQUE) : flags, mask, ray);
  while (query.Proceed())
  {
    if (query.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE)
    {
      RayHitInfo candidate;
      RAY_HIT_INFO_CREATE_RAY_QUERY_CANDIDATE(candidate, query)
      Ray candidateRay = rayCreateEmpty();
      candidateRay.origin = ray.Origin;
      candidateRay.direction = ray.Direction;
      candidateRay.tMax = ray.TMax;
      if (!isVoxelCoverageCandidateClipped(candidateRay, candidate))
      {
        query.CommitNonOpaqueTriangleHit();
      }
    }
  }
  RAY_HIT_INFO_CREATE_RAY_QUERY_COMMITTED(hit, query)
  if (!hit.hasHit)
  {
    hit = (RayHitInfo)0;
  }
  return hit;
}
