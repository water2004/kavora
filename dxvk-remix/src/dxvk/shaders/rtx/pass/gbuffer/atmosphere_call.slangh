#pragma once

// The callable reads only the ray and writes only its integrated medium.
// The caller composes this result after unordered geometry and before the surface.
struct AtmosphereCallData
{
  float3 origin;
  float distance;
  float3 direction;
  uint volumeHint;
  float3 mediumExtinction;
  float3 radiance;
  float3 transmittance;
};
