[submodule "kavora-runtime/include/vulkan"]
	path = kavora-runtime/include/vulkan
	url = https://github.com/KhronosGroup/Vulkan-Headers
[submodule "kavora-runtime/submodules/rtxdi"]
	path = kavora-runtime/submodules/rtxdi
	url = https://github.com/NVIDIA-RTX/RTXDI.git
	branch = remix
[submodule "kavora-runtime/submodules/rtxcr"]
	path = kavora-runtime/submodules/rtxcr
	url = https://github.com/NVIDIA-RTX/RTXCR-Material-Library.git
[submodule "kavora-runtime/submodules/nrc"]
	path = kavora-runtime/submodules/nrc
	url = https://github.com/NVIDIAGameWorks/Neural-Radiance-Cache.git
[submodule "kavora-runtime/submodules/nvapi/nvapi"]
	path = kavora-runtime/submodules/nvapi
	url = https://github.com/NVIDIA/nvapi.git
[submodule "kavora-runtime/submodules/Detours"]
	path = kavora-runtime/submodules/Detours
	url = https://github.com/microsoft/Detours.git
[submodule "kavora-runtime/submodules/xess"]
	path = kavora-runtime/submodules/xess
	url = https://github.com/intel/xess.git
	shallow = false
[submodule "kavora-runtime/include/MathLib/External/sse2neon"]
	path = kavora-runtime/include/MathLib/External/sse2neon
	url = https://github.com/DLTcollab/sse2neon.git
[submodule "kavora-runtime/submodules/dlss"]
	path = kavora-runtime/submodules/dlss
	url = https://github.com/NVIDIA/DLSS.git
[submodule "kavora-runtime/submodules/sharc"]
	path = kavora-runtime/submodules/sharc
	url = https://github.com/NVIDIAGameWorks/Spatial-Hash-Radiance-Cache.git
