{
    "schemaVersion": 1,
    "id": "kavora",
    "provides": [
        "kavora-far-terrain-v1",
        "kavora-quad-mesh-v1"
    ],
    "version": "${version}",
    "name": "Kavora",
    "icon": "assets/kavora/icon.png",
    "description": "Hardware-accelerated path tracing for Minecraft using Vulkan and NVIDIA RTX Remix. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA",
        "GBwater"
    ],
    "license": [
        "Apache-2.0",
        "LGPL-3.0-only"
    ],
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "org.edtp.kavora.WorkerPoolCap"
        ],
        "main": [
            "org.edtp.kavora.KavoraCommonMod"
        ],
        "client": [
            "org.edtp.kavora.KavoraMod"
        ],
        "sodium:config_api_user": [
            "org.edtp.kavora.settings.KavoraSodiumConfig"
        ]
    },
    "mixins": [
        "kavora.mixins.json",
        "kavora-sodium.mixins.json"
    ],
    "accessWidener": "kavora.accesswidener",
    "depends": {
        "fabricloader": ">=0.20.1",
        "fabric-api": ">=0.165.0+26.3",
        "sodium": "0.9.2",
        "minecraft": "26.3",
        "java": ">=25"
    },
    "breaks": {
        "voxy": "*",
        "rtx-remix-renderer": "*"
    }
}
