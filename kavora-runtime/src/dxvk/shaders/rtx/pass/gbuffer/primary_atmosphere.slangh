#pragma once

#include "rtx/pass/gbuffer/path_storage.slangh"
import "rtx/algorithm/atmosphere.slang";

uint primaryAtmosphereOffset(uint2 pixel)
{
  return primaryAtmosphereBase(pixel.y * cb.camera.resolution.x + pixel.x);
}

void storeAtmosphereTransfer(uint offset, AtmosphereSegment segment)
{
  PathStorage[offset] = asuint(segment.radiance.x);
  PathStorage[offset + 1] = asuint(segment.radiance.y);
  PathStorage[offset + 2] = asuint(segment.radiance.z);
  PathStorage[offset + 3] = asuint(segment.transmittance.x);
  PathStorage[offset + 4] = asuint(segment.transmittance.y);
  PathStorage[offset + 5] = asuint(segment.transmittance.z);
  PathStorage[offset + 6] = packCloudMoments(segment.cloudMoments);
}

AtmosphereSegment loadAtmosphereTransfer(uint offset)
{
  AtmosphereSegment segment;
  segment.radiance = asfloat(uint3(PathStorage[offset], PathStorage[offset + 1], PathStorage[offset + 2]));
  segment.transmittance = asfloat(uint3(PathStorage[offset + 3], PathStorage[offset + 4], PathStorage[offset + 5]));
  segment.cloudMoments = unpackCloudMoments(PathStorage[offset + 6]);
  return segment;
}

void storePrimaryAtmosphere(uint2 pixel, AtmosphereSegment segment)
{
  storeAtmosphereTransfer(primaryAtmosphereOffset(pixel), segment);
}

AtmosphereSegment loadPrimaryAtmosphere(uint2 pixel)
{
  return loadAtmosphereTransfer(primaryAtmosphereOffset(pixel));
}
