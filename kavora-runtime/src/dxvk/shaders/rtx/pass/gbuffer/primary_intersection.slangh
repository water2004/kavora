#pragma once

#include "rtx/pass/gbuffer/path_storage.slangh"
#include "rtx/utility/debug_view_helpers.slangh"
#include "rtx/concept/ray/ray.slangh"

uint8_t primaryRayMask()
{
  uint8_t mask = OBJECT_MASK_ALL | OBJECT_MASK_VIEWMODEL | OBJECT_MASK_PLAYER_MODEL_VIRTUAL;
  if (cb.enablePlayerModelInPrimarySpace)
  {
    mask |= OBJECT_MASK_PLAYER_MODEL;
  }
  return mask;
}

uint primaryRayFlags()
{
  return RAY_FLAG_FORCE_OPAQUE | (cb.startInMediumMaterialIndex != SURFACE_INDEX_INVALID
    ? 0 : RAY_FLAG_CULL_BACK_FACING_TRIANGLES);
}

uint primaryIntersectionOffset(uint2 pixel)
{
  return primaryIntersectionBase(pixel.y * cb.camera.resolution.x + pixel.x);
}

void storePrimaryIntersection(uint2 pixel, RayHitInfo hit)
{
  const uint offset = primaryIntersectionOffset(pixel);
  PathStorage[offset] = asuint(hit.hitDistance);
  PathStorage[offset + 1] = hit.barycentricCoordinates;
  PathStorage[offset + 2] = hit.primitiveIndex;
  // Vulkan instance custom indices occupy 24 bits. The geometry index stays full width.
  PathStorage[offset + 3] = hit.customIndex | (uint(hit.frontHit) << 24) | (uint(hit.hasHit) << 25);
  PathStorage[offset + 4] = hit.geometryIndex;
}

RayHitInfo loadPrimaryIntersection(uint2 pixel)
{
  const uint offset = primaryIntersectionOffset(pixel);
  RayHitInfo hit;
  hit.hitDistance = asfloat(PathStorage[offset]);
  hit.barycentricCoordinates = PathStorage[offset + 1];
  hit.primitiveIndex = PathStorage[offset + 2];
  const uint packedIndex = PathStorage[offset + 3];
  hit.customIndex = packedIndex & 0xffffffu;
  hit.frontHit = (packedIndex & (1u << 24)) != 0;
  hit.hasHit = (packedIndex & (1u << 25)) != 0;
  hit.geometryIndex = PathStorage[offset + 4];
  return hit;
}
