#pragma once

#include "rtx/pass/gbuffer/path_storage.slangh"
#include "rtx/pass/gbuffer/gbuffer_queue.slangh"
#include "rtx/algorithm/geometry_resolver_state.slangh"

layout(binding = GBUFFER_BINDING_PSR_QUEUE_INPUT) RWStructuredBuffer<uint> PSRQueueInput;
layout(binding = GBUFFER_BINDING_PSR_QUEUE_OUTPUT) RWStructuredBuffer<uint> PSRQueueOutput;

uint psrPixelIndex(uint2 pixel)
{
  return pixel.y * cb.camera.resolution.x + pixel.x;
}

uint2 psrPixelCoordinate(uint index)
{
  return uint2(index % cb.camera.resolution.x, index / cb.camera.resolution.x);
}

void storePSRState(uint pixel, GeometryPSRResolverState state, uint seed)
{
  const uint b = pixel * GBUFFER_PSR_STATE_WORDS;
  PathStorage[b + 0] = asuint(state._origin.x);
  PathStorage[b + 1] = asuint(state._origin.y);
  PathStorage[b + 2] = asuint(state._origin.z);
  PathStorage[b + 3] = f32tof16(state._coneRadius) | (uint(state._encodedFlags) << 16);
  PathStorage[b + 4] = asuint(state.radiance.x);
  PathStorage[b + 5] = asuint(state.radiance.y);
  PathStorage[b + 6] = asuint(state.radiance.z);
  PathStorage[b + 7] = asuint(state.renderTargetPath ? state.renderTargetScreenDistance : state.apparentHitDistance);
  PathStorage[b + 8] = packGBufferHalf2(state._accumulatedRotation.xy);
  PathStorage[b + 9] = packGBufferHalf2(state._accumulatedRotation.zw);
  PathStorage[b + 10] = asuint(state.accumulatedHitDistance);
  PathStorage[b + 11] = state.mediumState;
  PathStorage[b + 12] = packGBufferHalf2(state._direction.xy);
  PathStorage[b + 13] = f32tof16(state._direction.z) | (uint(state._rayMask) << 16) | (uint(state.bounceIteration) << 24);
  PathStorage[b + 14] = packGBufferHalf2(state.attenuation.xy);
  PathStorage[b + 15] = f32tof16(state.attenuation.z) | (uint(state._compactedCoordinate.x) << 16);
  PathStorage[b + 16] = uint(state._compactedCoordinate.y) | (f32tof16(state.refractionScale) << 16);
  PathStorage[b + 17] = seed;
}

GeometryPSRResolverState loadPSRState(uint pixel)
{
  const uint b = pixel * GBUFFER_PSR_STATE_WORDS;
  GeometryPSRResolverState state;
  state._origin = asfloat(uint3(PathStorage[b], PathStorage[b + 1], PathStorage[b + 2]));
  state._coneRadius = float16_t(f16tof32(PathStorage[b + 3] & 0xffff));
  state._encodedFlags = uint16_t(PathStorage[b + 3] >> 16);
  state.radiance = asfloat(uint3(PathStorage[b + 4], PathStorage[b + 5], PathStorage[b + 6]));
  state._segmentHitDistance = 0.0f;
  state._accumulatedRotation = f16vec4(unpackGBufferHalf2(PathStorage[b + 8]), unpackGBufferHalf2(PathStorage[b + 9]));
  state.accumulatedHitDistance = asfloat(PathStorage[b + 10]);
  state.mediumState = PathStorage[b + 11];
  state._direction = f16vec3(unpackGBufferHalf2(PathStorage[b + 12]), f16tof32(PathStorage[b + 13] & 0xffff));
  state._rayMask = uint8_t(PathStorage[b + 13] >> 16);
  state.bounceIteration = uint8_t(PathStorage[b + 13] >> 24);
  state.attenuation = f16vec3(unpackGBufferHalf2(PathStorage[b + 14]), f16tof32(PathStorage[b + 15] & 0xffff));
  const uint refractionAndCoordinate = PathStorage[b + 16];
  state._compactedCoordinate = u16vec2(PathStorage[b + 15] >> 16, uint16_t(refractionAndCoordinate));
  state.refractionScale = f16tof32(refractionAndCoordinate >> 16);
  const float projectionDistance = asfloat(PathStorage[b + 7]);
  state.renderTargetScreenDistance = projectionDistance;
  state.apparentHitDistance = projectionDistance;
  state.renderTargetTriangle = uint2(SURFACE_INDEX_INVALID, 0);
  state.renderTargetTile = vec2(0.0f);
  return state;
}
