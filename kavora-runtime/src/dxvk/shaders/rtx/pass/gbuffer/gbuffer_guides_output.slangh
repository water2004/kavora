#pragma once

#include "rtx/utility/brdf.slangh"
#include "rtx/pass/ray_reconstruction/rr_guide_albedo.slangh"

// This file writes the DLSS-RR albedo guides under the compacted GBuffer. The GBuffer builds them for every pixel,
// since inactive pixels store no material for prepare_ray_reconstruction to build them from.

// These constants name the kind of first hit that the primary pass leaves in the specular guide's alpha for the decal pass.
// Misses, PSR pixels and first hits that no decal can cover get kGuideSurfaceNone, so the decal pass skips them.
static const uint kGuideSurfaceNone = 0;
static const uint kGuideSurfaceOpaque = 1;
static const uint kGuideSurfaceTranslucent = 2;
static const uint kGuideSurfaceOther = 3;

// The specular guide's 2-bit alpha holds the kind, so its largest value maps to 1.
static const float kGuideSurfaceKindScale = 3.0f;

// Each PSR pass contributes to its path's guide once.
// The diffuse guide's alpha mirrors PrimaryAlbedo after prepare RR, which is 1 for a primary hit and 0 for a miss.
void guidesSeedPixel(uvec2 pixelCoordinate)
{
  PrimaryAlbedoDLSSRR[pixelCoordinate] = vec4(0.0f);
  PrimarySpecularAlbedoDLSSRR[pixelCoordinate] = vec4(0.0f);
}

// Mirrors getRoughnessFactor in prepare_ray_reconstruction.
float guideRoughnessFactor(float perceptualRoughness)
{
  return cb.sparseRenderingArgs.guideRoughnessDemodulationMultiplier *
    pow(1.0f / (perceptualRoughness + 0.1f), cb.sparseRenderingArgs.guideRoughnessDemodulationOffset);
}

// Returns an opaque material's opacity as the integrator decodes it from the GBuffer.
// Returns 1 for other material types, whose base reflectivity is not adjusted.
float guideOpacity(GBufferMemoryPolymorphicSurfaceMaterialInteraction materialMemory)
{
  if (gBufferMemoryPolymorphicSurfaceMaterialInteractionGetTypeHelper(materialMemory) != surfaceMaterialTypeOpaque)
  {
    return 1.0f;
  }

  return opaqueSurfaceMaterialInteractionCreate(materialMemory).opacity;
}

// Mirrors opaqueSurfaceMaterialGetAdjustedBaseReflectivity, whose result demodulation sees in place of the raw base reflectivity.
vec3 guideAdjustBaseReflectivity(vec3 baseReflectivity, float opacity)
{
  return max(baseReflectivity, vec3(1.0f - opacity));
}

// Derives specular albedo the way demodulate does and scales it as prepare_ray_reconstruction does.
vec3 guideSpecularAlbedo(
  uvec2 pixelCoordinate, vec3 baseReflectivity, float perceptualRoughness, vec3 worldShadingNormal,
  vec4 accumulatedRotation, bool directionAltered)
{
  const vec3 virtualShadingNormal = rrVirtualNormal(worldShadingNormal, accumulatedRotation,
    directionAltered && cb.enableCalculateVirtualShadingNormals);

  const vec3 cameraDirection = cameraPixelCoordinateToDirection(cb.camera, ivec2(pixelCoordinate)).worldDirection;

  vec3 specularAlbedo = evalSpecularAlbedoGGXSchlick(
    baseReflectivity, calcRoughness(perceptualRoughness), dot(virtualShadingNormal, -cameraDirection));

  specularAlbedo *= guideRoughnessFactor(perceptualRoughness);

  return specularAlbedo;
}

// Adds a surface that a PSR pass resolved into the albedo guides.
void guidesAccumulateAlbedo<let PRIMARY_SURFACE : bool>(
  uvec2 pixelCoordinate,
  GBufferMemoryPolymorphicSurfaceMaterialInteraction materialMemory,
  vec3 attenuation, vec4 accumulatedRotation, bool directionAltered)
{
  const vec3 adjustedBaseReflectivity =
    guideAdjustBaseReflectivity(vec3(materialMemory.baseReflectivity), guideOpacity(materialMemory));
  const vec3 specularAlbedo = guideSpecularAlbedo(
    pixelCoordinate, adjustedBaseReflectivity, float(materialMemory.perceptualRoughness),
    vec3(materialMemory.worldShadingNormal), accumulatedRotation, directionAltered);

  if (PRIMARY_SURFACE)
  {
    PrimaryAlbedoDLSSRR[pixelCoordinate] = vec4(vec3(materialMemory.albedo), 1.0f);
    PrimarySpecularAlbedoDLSSRR[pixelCoordinate] += vec4(specularAlbedo * rrPathTint(attenuation), 0.0f);
  }
  else
  {
    PrimarySpecularAlbedoDLSSRR[pixelCoordinate] += vec4(
      rrReflectedAlbedo(vec3(materialMemory.albedo), specularAlbedo, attenuation), 0.0f);
  }
}

// Writes the guides of a first hit that the primary pass resolved,
// which is the only surface the guides describe at such a pixel.
// Also leaves the inputs that the decal pass blends into, since an inactive pixel stores no material for that pass to read.
void guidesWriteFirstHit(
  uvec2 pixelCoordinate, bool decalCandidateSeen,
  GBufferMemoryPolymorphicSurfaceMaterialInteraction materialMemory, vec3 emissiveRadiance,
  vec3 attenuation, vec4 accumulatedRotation, bool directionAltered)
{
  const uint8_t materialType = gBufferMemoryPolymorphicSurfaceMaterialInteractionGetTypeHelper(materialMemory);
  uint surfaceKind = kGuideSurfaceNone;

  // Only the deferred decal pass reads the kind, so it stays none when that pass is off.
  if (decalCandidateSeen && cb.enableSeparateUnorderedApproximations && cb.enableDecalMaterialBlending)
  {
    if (materialType == surfaceMaterialTypeOpaque)
    {
      surfaceKind = kGuideSurfaceOpaque;
    }
    else if (materialType == surfaceMaterialTypeTranslucent)
    {
      surfaceKind = kGuideSurfaceTranslucent;
    }
    else
    {
      surfaceKind = kGuideSurfaceOther;
    }
  }

  const float opacity = guideOpacity(materialMemory);
  const vec3 adjustedBaseReflectivity = guideAdjustBaseReflectivity(vec3(materialMemory.baseReflectivity), opacity);
  const vec3 tint = rrPathTint(attenuation);
  const vec3 specularAlbedo = guideSpecularAlbedo(
    pixelCoordinate, adjustedBaseReflectivity, float(materialMemory.perceptualRoughness),
    vec3(materialMemory.worldShadingNormal), accumulatedRotation, directionAltered);

  PrimaryAlbedoDLSSRR[pixelCoordinate] = vec4(vec3(materialMemory.albedo), 1.0f);
  PrimarySpecularAlbedoDLSSRR[pixelCoordinate] = vec4(specularAlbedo * tint, float(surfaceKind) / kGuideSurfaceKindScale);

  // These are stored in reflection PSR slots, which a pixel whose first hit takes no PSR never uses.
  // The emissive radiance and the full attenuation let the decal pass add a decal's emissive change at every pixel.
  // An opaque surface also stores its raw base reflectivity and its opacity, which the decal pass blends and then adjusts.
  // A translucent surface stores its diffuse layer color, which is black without a layer, and its base reflectivity instead.
  if (surfaceKind != kGuideSurfaceNone)
  {
    vec3 blendInputColor = vec3(materialMemory.baseReflectivity);
    float blendInputValue = opacity;

    if (surfaceKind == kGuideSurfaceTranslucent)
    {
      blendInputColor = translucentSurfaceMaterialInteractionCreate(materialMemory).diffuseColor;
      blendInputValue = float(materialMemory.baseReflectivity.x);
    }

    ReflectionPSRData1[pixelCoordinate] = packFloat4x16(vec4(min(emissiveRadiance, float16Max), blendInputValue));
    ReflectionPSRData2[pixelCoordinate] = uint2(colorToR11G11B10(saturate(blendInputColor)), colorToR11G11B10(attenuation));
  }
}

uint guideSurfaceKind(vec4 specularAlbedoGuide)
{
  return uint(round(specularAlbedoGuide.a * kGuideSurfaceKindScale));
}

// Blends a decal into a first hit's guides the way decalMaterialInteractionBlend blends it into the material.
// Then derives the specular albedo once from the result, since GGX-Schlick is non-linear in what the decal changes.
// The caller reads `perceptualRoughness` and also hands it to the compacted blend before either blend writes it.
void guidesBlendDecal(
  uvec2 pixelCoordinate, vec4 specularAlbedoGuide, float perceptualRoughness,
  DecalMaterialInteraction decalMaterialInteraction, vec4 accumulatedRotation, bool directionAltered)
{
  const uint surfaceKind = guideSurfaceKind(specularAlbedoGuide);

  if (surfaceKind != kGuideSurfaceOpaque && surfaceKind != kGuideSurfaceTranslucent)
  {
    return;
  }

  const float opacity = decalMaterialInteraction.opacity;
  const uint2 blendInputs = ReflectionPSRData2[pixelCoordinate];
  const vec3 tint = rrPathTint(r11g11b10ToColor(blendInputs.y));
  const vec3 worldNormal = signedOctahedralToSphereDirection(
    snorm2x16ToFloat2x32(PrimaryWorldShadingNormalDense[pixelCoordinate]));
  const vec3 shadingNormal = normalize(mix(worldNormal, decalMaterialInteraction.shadingNormal, opacity));
  vec3 baseReflectivity;

  if (surfaceKind == kGuideSurfaceOpaque)
  {
    // Albedo and base reflectivity carry opacity premultiplied, so they composite source-over rather than as a lerp.
    const vec4 albedoGuide = PrimaryAlbedoDLSSRR[pixelCoordinate];
    PrimaryAlbedoDLSSRR[pixelCoordinate] = vec4(
      decalMaterialInteraction.albedo + albedoGuide.rgb * (1.0f - opacity),
      albedoGuide.a);

    // The surface's opacity composites source-over too, and the blended base reflectivity is adjusted with the result.
    const vec3 surfaceBaseReflectivity = r11g11b10ToColor(blendInputs.x);
    const float surfaceOpacity = float(unpackFloat4x16(ReflectionPSRData1[pixelCoordinate]).w);
    const float blendedSurfaceOpacity = opacity + surfaceOpacity * (1.0f - opacity);

    baseReflectivity = guideAdjustBaseReflectivity(
      decalMaterialInteraction.baseReflectivity + surfaceBaseReflectivity * (1.0f - opacity), blendedSurfaceOpacity);
    perceptualRoughness = roughnessToPerceptualRoughness(
      mix(perceptualRoughnessToRoughness(perceptualRoughness), decalMaterialInteraction.roughness, opacity));
  }
  else
  {
    // The decal blends into the glass's diffuse layer, which the deferred decal pass publishes as its albedo.
    const vec3 surfaceDiffuseColor = r11g11b10ToColor(blendInputs.x);
    const vec3 blendedDiffuseColor =
      mix(surfaceDiffuseColor, decalMaterialInteraction.albedo * cb.translucentDecalAlbedoFactor, opacity);
    const vec4 albedoGuide = PrimaryAlbedoDLSSRR[pixelCoordinate];
    PrimaryAlbedoDLSSRR[pixelCoordinate] = vec4(blendedDiffuseColor, albedoGuide.a);

    // Translucent guides take the fallback roughness, which a decal leaves alone.
    const float surfaceBaseReflectivity = float(unpackFloat4x16(ReflectionPSRData1[pixelCoordinate]).w);
    baseReflectivity =
      vec3(mix(surfaceBaseReflectivity, calcBt709Luminance(decalMaterialInteraction.baseReflectivity), opacity));
  }

  const vec3 specularAlbedo = guideSpecularAlbedo(
    pixelCoordinate, baseReflectivity, perceptualRoughness, shadingNormal, accumulatedRotation, directionAltered);

  PrimarySpecularAlbedoDLSSRR[pixelCoordinate] = vec4(specularAlbedo * tint, specularAlbedoGuide.a);
  PrimaryWorldShadingNormalDLSSRR[pixelCoordinate] = vec4(rrVirtualNormal(shadingNormal, accumulatedRotation,
    directionAltered && cb.enableCalculateVirtualShadingNormals), 0.0f);
  PrimaryPerceptualRoughness[pixelCoordinate] = perceptualRoughness;
  PrimaryWorldShadingNormalDense[pixelCoordinate] = float2x32ToSnorm2x16(sphereDirectionToSignedOctahedral(shadingNormal));
}
