#pragma once

#include "rtx/pass/gbuffer/primary_atmosphere_cache.h"
#include "rtx/pass/gbuffer/primary_atmosphere.slangh"
#include "rtx/utility/math.slangh"

uint hazeColumnStride()
{
  return cb.volumeArgs.fogIntegrationMode == 1
    ? cb.volumeArgs.fogIntegrationPixelStride : GBUFFER_ATMOSPHERE_COLUMN_STRIDE;
}

uint atmosphereColumnStride()
{
  return cb.volumeArgs.clouds.enable
    ? min(hazeColumnStride(), cb.volumeArgs.cloudIntegrationPixelStride)
    : hazeColumnStride();
}

uint2 columnExtent(uint stride)
{
  return (cb.camera.resolution + stride - 1) / stride;
}

uint2 atmosphereColumnExtent()
{
  return columnExtent(atmosphereColumnStride());
}

AtmosphereSegment interpolateAtmospherePrefix(AtmosphereSegment from, AtmosphereSegment to, float fraction)
{
  const float3 endT = saturate(to.transmittance / max(from.transmittance, 1e-30f));
  const float3 partialT = pow(max(endT, 1e-30f), fraction);
  const float3 weight = select(endT < 0.9999f, (1.0f - partialT) / max(1.0f - endT, 1e-30f), fraction.xxx);
  AtmosphereSegment transfer;
  transfer.radiance = lerp(from.radiance, to.radiance, weight);
  transfer.transmittance = from.transmittance * partialT;
  transfer.cloudMoments = lerp(from.cloudMoments, to.cloudMoments, fraction);
  return transfer;
}
// The endpoint record is private to this pixel until reconstruction overwrites it.
void storeAtmosphereEndpoint(uint2 pixel, float distance)
{
  PathStorage[primaryAtmosphereOffset(pixel)] = asuint(distance);
}

float loadAtmosphereEndpoint(uint2 pixel)
{
  return asfloat(PathStorage[primaryAtmosphereOffset(pixel)]);
}

// Endpoint transfers live in Primary's tail slab until Primary consumes the reconstructed image.
uint atmosphereColumnEndpointOffset(uint2 column, uint endpoint)
{
  const uint2 extent = atmosphereColumnExtent();
  return primaryTailBase(0) + ((column.y * extent.x + column.x)
    * GBUFFER_ATMOSPHERE_COLUMN_ENDPOINTS + endpoint) * GBUFFER_ATMOSPHERE_COLUMN_ENDPOINT_WORDS;
}

void storeAtmosphereColumnEndpoint(uint2 column, uint endpoint, float distance, AtmosphereSegment transfer)
{
  const uint offset = atmosphereColumnEndpointOffset(column, endpoint);
  PathStorage[offset] = asuint(distance);
  storeAtmosphereTransfer(offset + 1, transfer);
}

float4 loadAtmosphereColumnDepths(uint2 column)
{
  float4 depths;
  [unroll]
  for (uint i = 0; i < GBUFFER_ATMOSPHERE_COLUMN_ENDPOINTS; i++)
  {
    depths[i] = asfloat(PathStorage[atmosphereColumnEndpointOffset(column, i)]);
  }
  return depths;
}

// World-distance anchors are sorted. A finite endpoint cannot interpolate towards
// a sky miss: the miss may include cloud and air well beyond the requested surface.
AtmosphereSegment sampleAtmosphereColumn(uint2 column, float4 depths, float distance)
{
  const uint below = uint(depths.x < distance) + uint(depths.y < distance) + uint(depths.z < distance);
  const uint offset = atmosphereColumnEndpointOffset(column, below);
  const AtmosphereSegment to = loadAtmosphereTransfer(offset + 1);
  if (depths[below] == distance)
  {
    return to;
  }
  const float begin = below > 0 ? depths[below - 1] : 0.0f;
  const AtmosphereSegment from = below > 0
    ? loadAtmosphereTransfer(offset + 1 - GBUFFER_ATMOSPHERE_COLUMN_ENDPOINT_WORDS)
    : emptyAtmosphereSegment();
  if (depths[below] == floatMax || distance > depths[below])
  {
    return depths[below] == floatMax ? from : to;
  }
  const float fraction = saturate((distance - begin) / max(depths[below] - begin, 1e-6f));
  return interpolateAtmospherePrefix(from, to, fraction);
}
