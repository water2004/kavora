#pragma once

#include "rtx/pass/gbuffer/primary_atmosphere.slangh"
#include "rtx/pass/gbuffer/gbuffer_queue.slangh"
#include "rtx/algorithm/geometry_resolver_state.slangh"

layout(binding = GBUFFER_BINDING_PSR_QUEUE_OUTPUT) RWStructuredBuffer<uint> PrimaryQueue;

// Each invocation replaces its own consumed intersection and atmosphere records.
void storePrimaryResolveState(uint pixel, GeometryResolverState state, float remainingDistance,
  uint seed)
{
  const uint i = primaryIntersectionBase(pixel);
  const uint a = primaryAtmosphereBase(pixel);
  const uint t = primaryTailBase(pixel);
  PathStorage[i + 0] = asuint(state._origin.x);
  PathStorage[i + 1] = asuint(state._origin.y);
  PathStorage[i + 2] = asuint(state._origin.z);
  PathStorage[i + 3] = f32tof16(state._coneRadius) | (uint(state._encodedFlags) << 16);
  PathStorage[i + 4] = asuint(state.radiance.x);
  PathStorage[a + 0] = asuint(state.radiance.y);
  PathStorage[a + 1] = asuint(state.radiance.z);
  PathStorage[a + 2] = asuint(state._segmentHitDistance);
  PathStorage[a + 3] = packGBufferHalf2(state._accumulatedRotation.xy);
  PathStorage[a + 4] = packGBufferHalf2(state._accumulatedRotation.zw);
  PathStorage[a + 5] = asuint(state.accumulatedHitDistance);
  PathStorage[t + 0] = asuint(remainingDistance);
  PathStorage[t + 1] = packGBufferHalf2(state._direction.xy);
  PathStorage[t + 2] = f32tof16(state._direction.z) | (uint(state._rayMask) << 16);
  PathStorage[t + 3] = packGBufferHalf2(state.attenuation.xy);
  PathStorage[t + 4] = f32tof16(state.attenuation.z) | (uint(state._compactedCoordinate.x) << 16);
  PathStorage[t + 5] = state._compactedCoordinate.y;
  PathStorage[t + 6] = seed;
}

GeometryResolverState loadPrimaryResolveState(uint pixel, out float remainingDistance,
  out uint seed)
{
  const uint i = primaryIntersectionBase(pixel);
  const uint a = primaryAtmosphereBase(pixel);
  const uint t = primaryTailBase(pixel);
  GeometryResolverState state;
  state._origin = asfloat(uint3(PathStorage[i + 0], PathStorage[i + 1], PathStorage[i + 2]));
  state._coneRadius = float16_t(f16tof32(PathStorage[i + 3] & 0xffff));
  state._encodedFlags = uint16_t(PathStorage[i + 3] >> 16);
  state.radiance = asfloat(uint3(PathStorage[i + 4], PathStorage[a + 0], PathStorage[a + 1]));
  state._segmentHitDistance = asfloat(PathStorage[a + 2]);
  state._accumulatedRotation = f16vec4(unpackGBufferHalf2(PathStorage[a + 3]), unpackGBufferHalf2(PathStorage[a + 4]));
  state.accumulatedHitDistance = asfloat(PathStorage[a + 5]);
  remainingDistance = asfloat(PathStorage[t + 0]);
  state._direction = f16vec3(unpackGBufferHalf2(PathStorage[t + 1]), f16tof32(PathStorage[t + 2] & 0xffff));
  state._rayMask = uint8_t(PathStorage[t + 2] >> 16);
  state.attenuation = f16vec3(unpackGBufferHalf2(PathStorage[t + 3]), f16tof32(PathStorage[t + 4] & 0xffff));
  state._compactedCoordinate = u16vec2(PathStorage[t + 4] >> 16, PathStorage[t + 5]);
  seed = PathStorage[t + 6];
  return state;
}
