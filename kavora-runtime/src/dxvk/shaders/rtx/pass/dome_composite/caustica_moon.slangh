#pragma once

namespace LunarSurface {
float3 surfaceNormal(float2 disk) {
  return float3(disk, sqrt(max(1.0f - dot(disk, disk), 0.0f)));
}

float2 surfaceUv(float3 normal) {
  return float2(0.5f + atan2(normal.x, normal.z) / twoPi,
    0.5f - asin(clamp(normal.y, -1.0f, 1.0f)) / pi);
}

float4 radiance(Sampler2D<float4> map, float2 disk, float2 diskX, float2 diskY, uint phase) {
  const float radius = length(disk);
  if (radius >= 1.02f) {
    return 0;
  }
  const float3 normal = surfaceNormal(disk);
  const float2 uv = surfaceUv(normal);
  const float2 gradientX = surfaceUv(surfaceNormal(diskX)) - uv;
  const float2 gradientY = surfaceUv(surfaceNormal(diskY)) - uv;
  const float4 texel = map.SampleGrad(uv, gradientX, gradientY);
  const float3 albedo = pow(max(texel.rgb, 0), 2.2f) * (0.85f / 0.219f);
  const float latitude = asin(clamp(normal.y, -1.0f, 1.0f));
  const float longitude = atan2(normal.x, normal.z);
  const float step = 3.0f / 2048.0f;
  const float heightEast = map.SampleGrad(uv + float2(step, 0), gradientX, gradientY).a
    - map.SampleGrad(uv - float2(step, 0), gradientX, gradientY).a;
  const float heightNorth = map.SampleGrad(uv - float2(0, step), gradientX, gradientY).a
    - map.SampleGrad(uv + float2(0, step), gradientX, gradientY).a;
  const float3 east = float3(cos(longitude), 0, -sin(longitude));
  const float3 north = float3(-sin(latitude) * sin(longitude), cos(latitude), -sin(latitude) * cos(longitude));
  const float3 bumped = normalize(normal - 2.0f * heightEast / max(cos(latitude), 0.05f) * east - 2.0f * heightNorth * north);
  const float angle = float(phase) * (pi / 4.0f);
  const float3 light = float3(sin(angle), 0, cos(angle));
  const float incident = max(dot(bumped, light), 0);
  const float emission = max(normal.z, 1e-3f);
  const float reflected = 2.0f * incident / (incident + emission) * smoothstep(-0.02f, 0.06f, dot(normal, light));
  const float edge = 1.0f - smoothstep(0.97f, 1.02f, radius);
  return float4(max(albedo, 0.02f) * (reflected + 0.006f) * edge, 1);
}
}
