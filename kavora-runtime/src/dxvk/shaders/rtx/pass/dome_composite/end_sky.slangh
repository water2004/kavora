#pragma once

#include "rtx/pass/dome_composite/caustica_end.slangh"

float3 endSkyRadiance(NightSkyArgs args, Sampler2D<float3> background, float3 direction) {
  const float3 view = args.intensity.w > 0 ? direction.xzy : direction;
  const float3 horizontal = float3(args.rotation.x * view.x - args.rotation.y * view.z, view.y,
    args.rotation.y * view.x + args.rotation.x * view.z);
  const float3 local = float3(horizontal.x, args.rotation.z * horizontal.y - args.rotation.w * horizontal.z,
    args.rotation.w * horizontal.y + args.rotation.z * horizontal.z);
  return endRadiance(local, args.endParameters.x, background, args.endParameters.y, args.endParameters.z)
    * args.intensity.y;
}
