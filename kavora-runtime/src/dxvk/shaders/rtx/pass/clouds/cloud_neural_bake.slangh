import "rtx/algorithm/clouds.slang";
import "rtx/algorithm/cloud_neural_scattering.slang";
import "rtx/pass/cloud_parameters.slang";
import "rtx/utility/cloud_density.slang";
import "rtx/utility/cloud_phase.slang";
#include "rtx/pass/clouds/cloud_neural_model.h"

static const uint kInputs = CLOUD_NEURAL_INPUTS;
static const uint kDirections = CLOUD_NEURAL_DIRECTIONS;

struct NeuralCell
{
  float features[kInputs];
  float2 skyDepth;
  float prediction[kDirections];
};
groupshared NeuralCell Cells[CLOUD_NEURAL_SKY_BATCH];

float densityFeature(CloudDensityArgs density, float3 position, uint layer)
{
  return cloudDensity(density, position, CloudWeatherSampler, CloudBaseSampler, CloudDetailSampler, layer);
}

void writeSkyFeatures(CloudArgs args, float3 position, uint layer, float height, float altitude, uint lane, uint slot)
{
  const CloudDensityArgs density = cloudDensityParameters(args);
  if (lane < 4)
  {
    Cells[slot].features[lane] = cloudDensityFeature(density, position, layer, lane, args.meterToWorld,
      CloudWeatherSampler, CloudBaseSampler, CloudDetailSampler);
    return;
  }
  if (lane == 4)
  {
    const CloudLightingCache cache = sceneCloudLightingCache();
    const float2 depth = cache.local.SampleLevel(cloudLocalLightCoordinates(args, position, altitude, layer), 0);
    Cells[slot].skyDepth = depth;
    Cells[slot].features[4] = depth.x / (1.0f + depth.x);
    Cells[slot].features[5] = height;
  }
  if (lane == 7 || lane == 8)
    Cells[slot].features[lane] = densityFeature(density, position + args.up * (lane == 7 ? 300.0f : 800.0f) * args.meterToWorld, layer);
}

uint3 cloudNeuralTexel(uint3 cell, uint band)
{
  const uint light = cell.y / CLOUD_NEURAL_COLUMN_HEIGHT;
  const uint row = cell.y % CLOUD_NEURAL_COLUMN_HEIGHT;
  return uint3(cell.x, (light * CLOUD_NEURAL_BANDS + band) * CLOUD_NEURAL_COLUMN_HEIGHT + row, cell.z);
}

bool prepareNeuralCell(CloudArgs args, uint3 cell, uint lane, out uint lightIndex, uint slot = 0, uint stride = 10)
{
  lightIndex = cell.y / CLOUD_NEURAL_COLUMN_HEIGHT;
  const uint row = cell.y % CLOUD_NEURAL_COLUMN_HEIGHT;
  const uint layer = uint(row >= CLOUD_NEURAL_HEIGHT);
  const bool sky = lightIndex == CLOUD_NEURAL_SKY_CHANNEL;
  if (!cloudLayerEnabled(args, layer) || (!sky && ((args.activeCloudLights & (1u << lightIndex)) == 0 || args.multipleScattering <= 0)))
  {
    return false;
  }
  if (!sky)
  {
    if (lane == 0)
    {
      const float3 state = cloudSolarStateAtNode(cell, layer);
      Cells[slot].features[0] = state.x;
      Cells[slot].features[1] = state.y;
      Cells[slot].features[2] = state.z;
      Cells[slot].features[3] = dot(args.lights[lightIndex].directionToLight, args.up);
    }
    return true;
  }
  const float height = float(row - cloudNeuralRowOffset(layer)) / float(cloudNeuralHeightSamples(layer) - 1);
  const float altitude = lerp(cloudLayerBase(args, layer), cloudLayerTop(args, layer), height);
  const float3 position = cloudNeuralPosition(args, cell.xz, layer, altitude);
  for (uint feature = lane; feature < 9; feature += stride)
  {
    if (args.multipleScattering > 0 || feature == 4)
      writeSkyFeatures(args, position, layer, height, altitude, feature, slot);
  }
  return true;
}


float softplus(float x)
{
  return 0.25f * (max(x, 0.0f) + log(1.0f + exp(-abs(x))));
}

float3 neuralAngularFeatures(CloudArgs args, uint lightIndex, uint angle, uint layer)
{
  if (lightIndex == CLOUD_NEURAL_SKY_CHANNEL)
    return float3(0, 0, float(min(angle, 3u)) * (2.0f / 3.0f) - 1.0f);
  const float2 knot = cloudNeuralKnot(angle + 1, dot(args.up, args.lights[lightIndex].directionToLight));
  return float3(knot.x, cloudPhase(CloudPhaseSampler, knot.x, layer), knot.y);
}

float neuralFeature(uint index, float3 angular, float meanCosine, bool sky, uint slot = 0)
{
  if (sky)
    return index == 6 ? angular.z : index < 9 ? Cells[slot].features[index] : index == 9 ? meanCosine : 0;
  return index < 4 ? Cells[slot].features[index] : index < 7 ? angular[index - 4] : index == 7 ? meanCosine : 0;
}

void storeCloudLighting(uint3 cell, uint lane, uint channel, float strength, uint slot = 0)
{
  GroupMemoryBarrierWithGroupSync();
  if (channel == CLOUD_NEURAL_SKY_CHANNEL)
  {
    if (lane < 2)
    {
      float4 coefficients;
      [unroll]
      for (uint i = 0; i < 4; i++)
        coefficients[i] = cloudDiffuseBoundaryResponse(Cells[slot].skyDepth, i, strength > 0 ? Cells[slot].prediction[i] : 0, strength,
          uint(cell.y % CLOUD_NEURAL_COLUMN_HEIGHT >= CLOUD_NEURAL_HEIGHT))[lane];
      NeuralCloudOutput[cloudNeuralTexel(cell, lane)] = coefficients;
    }
    return;
  }
  if (lane < CLOUD_NEURAL_BANDS)
  {
    float4 endpoints;
    [unroll]
    for (int i = 0; i < 4; i++)
      endpoints[i] = Cells[slot].prediction[clamp(int(lane) * 4 + i - 1, 0, int(kDirections) - 1)];
    NeuralCloudOutput[cloudNeuralTexel(cell, lane)] = endpoints;
  }
}

CoopVec<float16_t, Rows> neuralLayer<int Rows, int Columns>(CoopVec<float16_t, Columns> inputs, uint layer)
{
  const int2 offsets = asint(NeuralCloudWeights.Load2(layer * 8));
  return coopVecMatMulAdd<float16_t, Rows, Columns, float16_t>(inputs, CoopVecComponentType::Float16,
    NeuralCloudWeights, offsets.x, CoopVecComponentType::Float16,
    NeuralCloudWeights, offsets.y, CoopVecComponentType::Float16,
    CoopVecMatrixLayout::InferencingOptimal, false, 0);
}

CoopVec<float16_t, CLOUD_NEURAL_WIDTH> neuralActivation(CoopVec<float16_t, CLOUD_NEURAL_WIDTH> value)
{
  return max(value, value * float16_t(0.01f));
}

[shader("compute")]
[numthreads(CLOUD_NEURAL_TENSOR_LANES, 1, 1)]
void main(uint3 group : SV_GroupID, uint invocation : SV_GroupIndex)
{
  const CloudArgs args = neuralCloudArgs();
  const uint channel = min(group.x / CLOUD_NEURAL_BEAM_GROUPS, uint(CLOUD_NEURAL_SKY_CHANNEL));
  const bool sky = channel == CLOUD_NEURAL_SKY_CHANNEL;
  const uint batch = sky ? CLOUD_NEURAL_SKY_BATCH : CLOUD_NEURAL_BEAM_BATCH;
  const uint directions = sky ? CLOUD_NEURAL_SKY_DIRECTIONS : kDirections;
  const uint slot = min(invocation / directions, batch - 1);
  const uint lane = invocation - slot * directions;
  const uint node = (group.x - channel * CLOUD_NEURAL_BEAM_GROUPS) * batch + slot;
  const uint3 cell = uint3(node % CLOUD_NEURAL_ATLAS_WIDTH,
    channel * CLOUD_NEURAL_COLUMN_HEIGHT + group.y, node / CLOUD_NEURAL_ATLAS_WIDTH);
  uint lightIndex;
  if (!prepareNeuralCell(args, cell, lane, lightIndex, slot, directions))
  {
    return;
  }
  GroupMemoryBarrierWithGroupSync();

  // Every lane participates in inference. Padded lanes repeat a valid input.
  if (args.multipleScattering <= 0)
  {
    storeCloudLighting(cell, lane, lightIndex, 0, slot);
    return;
  }
  const uint bank = sky ? CLOUD_NEURAL_HIDDEN_LAYERS + 1 : 0;
  const uint layerIndex = uint(group.y >= CLOUD_NEURAL_HEIGHT);
  const float meanCosine = cloudMeanCosine(layerIndex);
  const float3 angular = neuralAngularFeatures(args, lightIndex, min(lane, directions - 1), layerIndex);
  CoopVec<float16_t, CLOUD_NEURAL_INPUTS> input;
  [unroll]
  for (uint i = 0; i < kInputs; i++)
  {
    input[i] = float16_t(neuralFeature(i, angular, meanCosine, sky, slot));
  }
  var value = neuralActivation(neuralLayer<CLOUD_NEURAL_WIDTH, CLOUD_NEURAL_INPUTS>(input, bank));
  [unroll]
  for (uint layer = 1; layer < CLOUD_NEURAL_HIDDEN_LAYERS; layer++)
  {
    value = neuralActivation(neuralLayer<CLOUD_NEURAL_WIDTH, CLOUD_NEURAL_WIDTH>(value, bank + layer));
  }
  let result = neuralLayer<CLOUD_NEURAL_TENSOR_OUTPUTS, CLOUD_NEURAL_WIDTH>(value, bank + CLOUD_NEURAL_HIDDEN_LAYERS);
  if (lane < directions)
  {
    Cells[slot].prediction[lane] = softplus(float(result[0]));
  }
  storeCloudLighting(cell, lane, lightIndex, args.multipleScattering, slot);
}
