#pragma once

// Complex coefficients encode each star layer's rotation and UV scale.
static const float2 kEndPortalLayerTransform[16] = {
  float2(3.9936936, 1.4535856),
  float2(2.8773592, 2.7786335),
  float2(1.1588137, 3.5664619),
  float2(-0.8467266, 3.3960350),
  float2(-2.4896444, 2.0890597),
  float2(-3.0000000, 0.0000000),
  float2(-1.9781845, -1.9103105),
  float2(0.0872487, -2.4984771),
  float2(1.8202882, -1.3225168),
  float2(1.8793852, 0.6840403),
  float2(0.3038843, 1.7234136),
  float2(-1.2135255, 0.8816779),
  float2(-1.0600601, -0.6623991),
  float2(0.2419219, -0.9702957),
  float2(0.7500000, 0.0000000),
  float2(0.0868241, 0.4924039)
};

static const float3 kEndPortalLayerTint[16] = {
  float3(0.022, 0.098, 0.111), float3(0.012, 0.096, 0.089),
  float3(0.028, 0.102, 0.100), float3(0.047, 0.110, 0.115),
  float3(0.065, 0.118, 0.097), float3(0.064, 0.087, 0.124),
  float3(0.085, 0.112, 0.166), float3(0.097, 0.154, 0.091),
  float3(0.106, 0.131, 0.195), float3(0.098, 0.110, 0.187),
  float3(0.134, 0.138, 0.149), float3(0.070, 0.243, 0.236),
  float3(0.197, 0.143, 0.215), float3(0.047, 0.315, 0.322),
  float3(0.205, 0.390, 0.302), float3(0.081, 0.315, 0.661)
};

float3 endPortalEmission(OpaqueSurfaceMaterial material, float3 rayDirection)
{
  if (material.secondaryTextureIndex == BINDING_INDEX_INVALID ||
      material.emissiveColorTextureIndex == BINDING_INDEX_INVALID)
  {
    return 0.0f;
  }

  // Project the incident ray. This also gives a virtual view for portal hits seen in reflections.
  float4 projected = mul(cb.camera.translatedWorldToProjectionJittered, float4(rayDirection, 0.0f));
  float invW = rcp(max(abs(projected.w), 0.001f));
  float2 uv = projected.xy * (projected.w < 0.0f ? -invW : invW) * 0.5f + 0.5f;
  float2 pixel = rcp(float2(cb.camera.resolution));
  SamplerState sampler = samplers[nonuniformEXT(uint(material.samplerIndex))];
  Texture2D<float4> sky = textures[nonuniformEXT(uint(material.secondaryTextureIndex))];
  Texture2D<float4> stars = textures[nonuniformEXT(uint(material.emissiveColorTextureIndex))];
  float3 color = sky.SampleGrad(sampler, uv, float2(pixel.x, 0.0f), float2(0.0f, pixel.y)).rgb
    * kEndPortalLayerTint[0];

  // Normalize the continuous clock to a Minecraft day, the period of the vanilla texture motion.
  float scroll = frac(cb.timeSinceStartSeconds / 1200.0f) * 0.75f;
  uint layerCount = (material.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IS_END_GATEWAY) ? 16u : 15u;
  [loop]
  for (uint i = 0; i < layerCount; ++i)
  {
    float layer = float(i + 1);
    float2 axisU = kEndPortalLayerTransform[i];
    float2 axisV = float2(-axisU.y, axisU.x);
    float2 layerUv = axisU * uv.x + axisV * uv.y;
    layerUv += float2(0.25f + 8.5f / layer, 0.25f + (2.0f + layer / 1.5f) * scroll);
    color += stars.SampleGrad(sampler, layerUv, axisU * pixel.x, axisV * pixel.y).rgb
      * kEndPortalLayerTint[i];
  }
  return gammaToLinear(saturate(color)) * material.emissiveIntensity;
}
