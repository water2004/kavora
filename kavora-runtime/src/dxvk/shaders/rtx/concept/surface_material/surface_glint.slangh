#pragma once

// Glint adds to the shaded surface while preserving its existing coverage and material.
vec3 surfaceGlint(OpaqueSurfaceMaterial material, SurfaceInteraction surface, vec3 albedo, float lodBias)
{
  const float strength = cb.opaqueMaterialArgs.glintStrength;
  if (strength <= 0.f)
  {
    return vec3(0.f);
  }

  const uint mode = (material.flags & OPAQUE_SURFACE_MATERIAL_GLINT_MODE_MASK) >> OPAQUE_SURFACE_MATERIAL_GLINT_MODE_SHIFT;
  const float scale = mode == OPAQUE_SURFACE_MATERIAL_GLINT_MODE_ITEM ? 8.f :
    (mode == OPAQUE_SURFACE_MATERIAL_GLINT_MODE_ENTITY ? 0.5f : 0.16f);
  // Minecraft rotates the scrolling texture by ten degrees.
  const float2x2 rotation = float2x2(0.98480775f, -0.17364818f, 0.17364818f, 0.98480775f);
  const float time = cb.timeSinceStartSeconds * cb.opaqueMaterialArgs.glintSpeed * 8.f;
  const vec2 offset = vec2(-frac(time / 110.f), frac(time / 30.f));
  const vec2 uv = frac(mul(rotation, surface.textureCoordinates) * scale + offset);
  const float gradientScale = scale * exp2(lodBias);
  const vec3 glint = textures[nonuniformEXT(uint(material.glintTextureIndex))].SampleGrad(
    samplers[nonuniformEXT(uint(material.samplerIndex))], uv,
    mul(rotation, surface.textureGradientX) * gradientScale,
    mul(rotation, surface.textureGradientY) * gradientScale).rgb * strength;
  const vec3 pattern = glint * glint;

  // The glint softly lights the material beneath its colored sheen.
  const float patternLuminance = dot(pattern, vec3(0.2126f, 0.7152f, 0.0722f));
  const float diffuseGlow = 0.018f * strength + patternLuminance * 1.4f;
  return albedo * diffuseGlow + pattern * 0.2f;
}
