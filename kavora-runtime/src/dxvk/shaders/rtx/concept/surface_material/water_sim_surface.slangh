#pragma once

// Horizontal slope is stored in world axes, independent of the water atlas and mesh UVs.
float3 sampleWaterSimulation(float3 position) {
  const float2 planar = cb.isZUp ? position.xy : position.xz;
  const float2 uv = (planar - cb.waterSimulation.xy) * cb.waterSimulation.z;
  const float2 edge = min(uv, 1.0f - uv);
  const float fade = smoothstep(0.025f, 0.12f, min(edge.x, edge.y));
  if (fade <= 0.0f) {
    return float3(0.0f);
  }
  const float4 state = WaterSimulation.SampleLevel(LinearWrapSampler, uv, 0.0f);
  return state.xzw * fade;
}

bool hasWaterTransmissionOffset(PolymorphicSurfaceMaterialInteraction material) {
  return cb.waterSimulation.w && material.type == surfaceMaterialTypeTranslucent &&
    (material.bdata0 & TRANSLUCENT_SURFACE_MATERIAL_FLAG_SIMULATED_WATER);
}

// Positive crests remain at the mesh plane. Troughs can move the refracted
// ray's origin into the water once a short visibility probe clears the shore.
void offsetWaterTransmissionRay(inout Ray refractedRay, Ray incidentRay,
  float3 position, float3 geometryNormal, uint8_t rayMask) {
  const float normalUp = cb.isZUp ? geometryNormal.z : geometryNormal.y;
  const float directionUp = cb.isZUp ? incidentRay.direction.z : incidentRay.direction.y;
  if (abs(normalUp) < 0.85f || directionUp > -0.12f) {
    return;
  }

  const float3 wave = sampleWaterSimulation(position);
  const float2 planarDirection = cb.isZUp ? incidentRay.direction.xy : incidentRay.direction.xz;
  const float relativeDirection = directionUp - dot(wave.yz, planarDirection);
  if (wave.x >= -0.008f || relativeDirection > -0.12f) {
    return;
  }

  const float distance = min(wave.x / relativeDirection, 0.2f);
  RayDesc shore;
  shore.Origin = refractedRay.origin;
  shore.Direction = incidentRay.direction;
  shore.TMin = 0.0f;
  shore.TMax = distance;
  RayQuery<RAY_FLAG_CULL_NON_OPAQUE | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
  query.TraceRayInline(topLevelAS, 0, rayMask & (OBJECT_MASK_OPAQUE | OBJECT_MASK_ALL_DYNAMIC), shore);
  while (query.Proceed()) {}
  if (query.CommittedStatus() == COMMITTED_NOTHING) {
    refractedRay.origin += incidentRay.direction * distance;
    refractedRay.coneRadius += incidentRay.spreadAngle * distance;
  }
}
