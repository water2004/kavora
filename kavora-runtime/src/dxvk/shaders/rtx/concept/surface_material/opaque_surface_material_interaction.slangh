#pragma once

import "rtx/concept/surface_material/opaque_bsdf.slang";
import "rtx/concept/surface_material/opaque_lobe_sampling.slang";
import "rtx/concept/surface_material/subsurface_material.slang";

import "rtx/concept/surface_material/water_normal_coordinates.slang";
import "rtx/concept/surface_material/end_portal_material.slang";
