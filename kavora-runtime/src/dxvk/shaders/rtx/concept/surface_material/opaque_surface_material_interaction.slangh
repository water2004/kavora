// Opaque Surface Material Interaction Helper Functions

#ifdef OPAQUE_MATERIAL_USE_POM
import "rtx/concept/surface_material/parallax_occlusion.slang";

[ForceInline]
ParallaxSettings parallaxSettings()
{
  return { uint(cb.pomMode), cb.totalMipBias, cb.pomMaxIterations };
}

[ForceInline]
float3 pomCalculateTexcoord(OpaqueSurfaceMaterial material, SurfaceInteraction surface, float3 viewDirection,
  inout uint iterations)
{
  const ParallaxSurface coordinates = { surface.textureCoordinates, surface.textureGradientX,
    surface.textureGradientY, surface.textureCoordinateBounds };
  return traceParallax(textures[nonuniformEXT(uint(material.heightTextureIndex))],
    samplers[nonuniformEXT(uint(material.reliefSamplerIndex))], material.displaceIn, material.displaceOut,
    coordinates, viewDirection, parallaxSettings(), iterations);
}

float opaqueSurfaceMaterialInteractionCalcHeightThroughput(
  MinimalSurfaceInteraction minimalSurfaceInteraction,
  vec3 rayDirection,
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  float4 textureCoordinates)
{
  // rebuild tangent space
  const f16mat3 worldToTangent = f16mat3(
    minimalSurfaceInteraction.geometryTangent,
    minimalSurfaceInteraction.geometryBitangent,
    minimalSurfaceInteraction.geometryNormal);
  const vec3 lightDirTangentSpace = normalize(mul(worldToTangent, rayDirection));
  return parallaxVisibility(textures[nonuniformEXT(uint(opaqueSurfaceMaterial.heightTextureIndex))],
    samplers[nonuniformEXT(uint(opaqueSurfaceMaterial.reliefSamplerIndex))],
    opaqueSurfaceMaterial.displaceIn, opaqueSurfaceMaterial.displaceOut,
    textureCoordinates.xy, lightDirTangentSpace, unpackAtlasBounds(textureCoordinates.zw), parallaxSettings());
}
#endif

SubsurfaceMaterialInteraction subsurfaceMaterialInteractionCreate(
  SubsurfaceMaterial subsurfaceMaterial,
  SurfaceInteraction surfaceInteraction,
  uint16_t samplerIndex)
{
  vec4 transmittanceColor = 0.0f;
  vec4 subsurfaceMeasurementDistance = 0.0f;
  vec4 subsurfaceSingleScatteringAlbedo = 0.0f;

  bool isDiffusionProfile = subsurfaceMaterial.maxSampleRadius > 0.0f;

  bool measurementDistanceLoaded = !isDiffusionProfile ? surfaceMaterialInteractionTextureReadHelper(subsurfaceMaterial.subsurfaceThicknessTextureIndex, samplerIndex, surfaceInteraction, subsurfaceMeasurementDistance) : false;
  bool transmittanceColorLoaded = surfaceMaterialInteractionTextureReadHelper(subsurfaceMaterial.subsurfaceTransmittanceTextureIndex, samplerIndex, surfaceInteraction, transmittanceColor);
  bool singleScatteringAlbedoLoaded = surfaceMaterialInteractionTextureReadHelper(subsurfaceMaterial.subsurfaceSingleScatteringAlbedoTextureIndex, samplerIndex, surfaceInteraction, subsurfaceSingleScatteringAlbedo);

  SubsurfaceMaterialInteraction subsurfaceMaterialInteraction;

  if (measurementDistanceLoaded)
  {
    subsurfaceMaterialInteraction.measurementDistance = subsurfaceMeasurementDistance.r;
  }
  else
  {
    subsurfaceMaterialInteraction.measurementDistance = subsurfaceMaterial.measurementDistance;
  }

  // volumetricAttenuationCoefficient must be read behind measurementDistance, because if using sss textures, the volumetricAttenuationCoefficient need to be calculated base on measurementDistance
  if (transmittanceColorLoaded)
  {
    // Note: It's common to use diffuse albedo color as SSS transmission color, Remix assumes all textures are not using sRGB formats, so we follow the assumption here.
    if (isDiffusionProfile)
    {
      transmittanceColor = gammaToLinear(transmittanceColor);
    }
  }
  else
  {
    if (!isDiffusionProfile) // Thin Opaque
    {
      transmittanceColor.rgb = evalBeerLambertAttenuation(subsurfaceMaterial.volumetricAttenuationCoefficient, subsurfaceMaterial.measurementDistance);
    }
    else // SSS
    {
      transmittanceColor.rgb = subsurfaceMaterial.volumetricAttenuationCoefficient;
    }
  }
  subsurfaceMaterialInteraction.packedTransmittanceColor = colorToR11G11B10(transmittanceColor.rgb);

  if (singleScatteringAlbedoLoaded)
  {
    subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = colorToR11G11B10(subsurfaceSingleScatteringAlbedo.rgb);
  }
  else
  {
    subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = colorToR11G11B10(subsurfaceMaterial.singleScatteringAlbedo);
  }

  subsurfaceMaterialInteraction.volumetricAnisotropy = f16ToSnorm8(subsurfaceMaterial.volumetricAnisotropy);

  subsurfaceMaterialInteraction.maxSampleRadius = subsurfaceMaterial.maxSampleRadius != 0.0f ? f16ToUnorm8(max(subsurfaceMaterial.maxSampleRadius, materialSssEpsilon)) : 0;

  return subsurfaceMaterialInteraction;
}

void storeColorOverlayedWithTextureResolutionCheckersInDebugView(vec3 colorValue, uint textureIndex, SurfaceInteraction surfaceInteraction)
{
  if (textureIndex != BINDING_INDEX_INVALID)
  {
    uint2 texDims;
    textures[nonuniformEXT(uint(textureIndex))].GetDimensions(texDims.x, texDims.y);

    colorValue = 
      tintColorValueWithTextureResolutionCheckers(
        colorValue,
        surfaceInteraction.textureCoordinates,
        surfaceInteraction.textureGradientX * cb.upscaleFactor,
        surfaceInteraction.textureGradientY * cb.upscaleFactor,
        texDims,
        cb.debugKnob.x,
        cb.debugKnob.y);
    storeInDebugView(getDispatchRaysIndex().xy, colorValue);
  }
}

uint8_t calcMipLevelAccessedForSamplerFeedback(SurfaceInteraction surfaceInteraction)
{
  // assume fixed 4k size to report stable accessed mip for differently sized textures
  const uint2 fullBoxSize = uint2(4096, 4096);

  vec2 ddx_tex = surfaceInteraction.textureGradientX * cb.upscaleFactor;
  vec2 ddy_tex = surfaceInteraction.textureGradientY * cb.upscaleFactor;
  ddx_tex *= fullBoxSize;
  ddy_tex *= fullBoxSize;
  const float ddSq = max(dot(ddx_tex, ddx_tex), dot(ddy_tex, ddy_tex));

  return uint8_t(clamp(0.5f * log2(ddSq), 0, 255));
}

void storeSamplerFeedback(uint32_t samplerFeedbackStamp, SurfaceInteraction surfaceInteraction)
{
  if (samplerFeedbackStamp != SAMPLER_FEEDBACK_INVALID)
  {
    uint32_t oldvalue;
    InterlockedMin(
      SamplerFeedbackBuffer[samplerFeedbackStamp],
      uint32_t(calcMipLevelAccessedForSamplerFeedback(surfaceInteraction)),
      oldvalue);
  }
}

void overrideMaterialInteractionForEye(
  inout OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  const OpaqueSurfaceMaterial            opaqueSurfaceMaterial,
  inout SurfaceInteraction               surfaceInteraction,
  const vec2                            irisParallaxOffset,
  const bool                            irisVisible,
  const float                           viewCosine,
  const vec3                          whitesAlbedo
)
{
  float2 uvIris = eyeCalcIrisUvParallaxed(surfaceInteraction.textureCoordinates, irisParallaxOffset);

  bool    irisLoaded;
  vec4 irisSample;
  {
    // 'surfaceMaterialInteractionTextureReadHelper' requires 'surfaceInteraction.textureCoordinates'
    vec2 savedCoordinates = surfaceInteraction.textureCoordinates;
    // so set iris UV temporarily
    surfaceInteraction.textureCoordinates = uvIris;
    irisLoaded                            = surfaceMaterialInteractionTextureReadHelper(
      opaqueSurfaceMaterial.secondaryTextureIndex,
      opaqueSurfaceMaterial.samplerIndex,
      surfaceInteraction,
      irisSample
    );
    // and revert UV back
    surfaceInteraction.textureCoordinates = savedCoordinates;
  }

  if (!irisLoaded)
  {
    return;
  }

  // Note: Gamma correct albedo input (be it from a constant or a texture). Currently assuming all textures are not using sRGB formats which
  // automatically do this conversion.
  // Todo: Disable this for when a sRGB texture is the source of the albedo.
  irisSample.rgb = gammaToLinear(irisSample.rgb);
  // Where the view ray does not reach the iris through the cornea, the whites show.
  irisSample.a = irisVisible ? irisSample.a : 0.f;
  irisSample.rgb *= eyeCalcLimbalRing(uvIris, viewCosine);

  // blend between whites and iris
  vec3 eyeAlbedo = mix(
    saturate(whitesAlbedo * cb.eyeArgs.whitesAlbedoScale),
    irisSample.rgb,
    irisSample.a // 0 (transparent) - whites, 1 (opaque) - iris
  );
  // NOTE: eye redness can be added here, if a game can provide such data

  const float eyeRoughness  = cb.eyeArgs.roughness;
  const float eyeMetallic   = 0.f;
  const float eyeOpacity    = 1.f;
  const float eyeAnisotropy = 0.f;
  calcRoughness(
    eyeRoughness,
    eyeAnisotropy,
    opaqueSurfaceMaterialInteraction.isotropicRoughness,
    opaqueSurfaceMaterialInteraction.anisotropicRoughness
  );
  opaqueSurfaceMaterialInteraction.albedo           = albedoToAdjustedAlbedo(eyeAlbedo, eyeMetallic, eyeOpacity);
  opaqueSurfaceMaterialInteraction.baseReflectivity = calcBaseReflectivity(eyeAlbedo, eyeMetallic, eyeOpacity);
  opaqueSurfaceMaterialInteraction.opacity          = eyeOpacity;

  opaqueSurfaceMaterialInteraction.emissiveRadiance =
    irisSample.rgb * irisSample.a *
    opaqueSurfaceMaterial.emissiveIntensity;
}

// Opaque Surface Material Interaction Functions

// POM, base color and base opacity are evaluated once before the remaining shading.
struct OpaqueMaterialSample
{
  vec3 albedo;
  float opacity;
  float emissiveBlendOverrideInfluence;
  float thinFilmThickness;
  uint8_t flags;
};

float opaqueSurfaceMaterialResolvedOpacity(OpaqueSurfaceMaterial material, Surface surface, OpaqueMaterialSample sample)
{
  // The iris override replaces opacity independently of its sampled color.
  if (cb.eyeArgs.enableEyes && surface.isEye && material.secondaryTextureIndex != BINDING_INDEX_INVALID)
  {
    return 1.0f;
  }
  return sample.opacity;
}

OpaqueMaterialSample opaqueSurfaceMaterialPrepare<let EnablePom : bool>(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  Surface surface,
  inout SurfaceInteraction surfaceInteraction,
  MinimalRayInteraction minimalRayInteraction,
  bool evaluatePomSilhouette = false)
{
  OpaqueMaterialSample sample;
  // Note: need initialize the flags explicitely to get rid of garbage data.
  sample.flags = 0;

  // Note: Does not represent if the thin film is enabled in all cases, such as if the thin film enable override is specified, merely concerned with if
  // it has been directly enabled by the material itself.
  const bool thinFilmEnabled = opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_USE_THIN_FILM_LAYER;
  const bool isHairCardMaterial = opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IS_HAIR_CARD;
  const float materialLodBias = isHairCardMaterial ? cb.hairCardMipBias : 0.0f;

  sample.flags |= thinFilmEnabled ? OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_USE_THIN_FILM_LAYER : 0;

#ifdef OPAQUE_MATERIAL_USE_POM
  if (EnablePom && cb.pomMode != DisplacementMode::Off && opaqueSurfaceMaterial.hasValidDisplacement())
  {
    // Note: The rows of the inverse of the matrix with columns T, B and N are these cross products divided by its determinant.
    // The division is needed because normalize does not remove the sign of a negative determinant.
    const vec3 bitangentCrossNormal = cross(surfaceInteraction.rawBitangent, surfaceInteraction.geometryNormal);
    const vec3 normalCrossTangent = cross(surfaceInteraction.geometryNormal, surfaceInteraction.rawTangent);
    const vec3 tangentCrossBitangent = cross(surfaceInteraction.rawTangent, surfaceInteraction.rawBitangent);
    const float basisDeterminant = dot(surfaceInteraction.rawTangent, bitangentCrossNormal);
    // TextureGradient x might be along the same direction as the view ray?  make a debug view that shows the dot product between textureGradient.x and viewDirTangentSpace?

    const vec3 viewDirection = minimalRayInteraction.viewDirection;
    vec3 viewDirTextureSpace = normalize(
      vec3(dot(bitangentCrossNormal, viewDirection), dot(normalCrossTangent, viewDirection), dot(tangentCrossBitangent, viewDirection)) /
      basisDeterminant);
    // Note: -1.f * TextureGradientX has the same x,y direction as viewDirTextureSpace, but calculating the correct z value is non-obvious.
    // Could potentially remove the need for the world to texture space transform if a faster way to calculate that z value is found.
    
    uint iterations = 0; // unused
    const vec3 pomHit = pomCalculateTexcoord(
        opaqueSurfaceMaterial,
        surfaceInteraction,
        viewDirTextureSpace,
        iterations);

    // WAR for REMIX-3709 - POM sometimes produces NaNs.
    surfaceInteraction.textureCoordinates = sanitize(pomHit.xy, surfaceInteraction.textureCoordinates);

#ifdef RESOLVE_POM_TRANSMISSION_SILHOUETTES
    if (evaluatePomSilhouette && pomHit.z >= 0.0f && pomHit.z <= 1.0f) {
      const float cosView = dot(surfaceInteraction.triangleNormal, viewDirection);
      if (cosView > 0.01f && surfaceInteraction.rawTangentScale > 0.0f) {
        const float4 bounds = surfaceInteraction.textureCoordinateBounds;
        const float worldScale = surfaceInteraction.rawTangentScale *
          AtlasSampling::displacementScale(bounds.x, bounds.y, bounds.z, bounds.w);
        const float depth = opaqueSurfaceMaterial.displaceIn -
          pomHit.z * (opaqueSurfaceMaterial.displaceIn + opaqueSurfaceMaterial.displaceOut);
        surfaceInteraction.pomRayDistance = sanitize(depth * worldScale / cosView, 0.0f);
      }
    }
#endif

    sample.flags |= OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_HAS_HEIGHT_TEXTURE;
  }
#endif

  vec4 albedoOpacitySample;
  const bool albedoOpacityLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.albedoOpacityTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, albedoOpacitySample, materialLodBias);

  // Load Albedo/Opacity

  vec3 albedo = opaqueSurfaceMaterial.albedoOpacityConstant.rgb;
  float opacity = opaqueSurfaceMaterial.albedoOpacityConstant.a;
  float emissiveBlendOverrideInfluence = float(1.0f);
  float thinFilmThickness = float(0.0f);

  // Baked terrain is the only surface using cascaded view positions, so key off of that
  const bool isBakedTerrain = surface.texcoordGenerationMode == uint(TexGenMode::CascadedViewPositions);

  // Texture operations have already been applied during terrain baking, so skip them for baked terrain surfaces
  const bool applyTextureOperations = !isBakedTerrain;

  // Note: Set thin film thickness constant fallback only if the thin film is enabled as a non-zero value here is responsible for indicating
  // if the thin film is in use by later code.
  if (thinFilmEnabled)
  {
    thinFilmThickness = opaqueSurfaceMaterial.thinFilmThicknessConstant;
  }

  if (albedoOpacityLoaded)
  {
    albedo = albedoOpacitySample.rgb;

    // Note: Thin film thickness and opacity deriving their values from the alpha channel are mutually exclusive, set the appropriate
    // one based on the specified flags, and set the opposing variable to a default value (the "default" value must match how the material is decoded from the
    // GBuffer as well). Ideally we'd want to simply fall back on the existing opacity/thin film thickness constants instead, but we currently do not have a
    // way of encoding these values in the GBuffer, so a code constant must be used instead. Finally, thinFilmEnabled does not need to be checked here as the
    // alpha as thin film thickness flag is only set on the CPU if the use thin film flag is true.
    // Also, the alpha channel of the texture should always be linear even if it is using a sRGB encoding (as the alpha channel in such encodings remains linear),
    // so no special compensation has to be done here (unlike the albedo which may need to have software gamma correction skipped when reading from sRGB textures).
    if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALPHA_IS_THIN_FILM_THICKNESS)
    {
      thinFilmThickness = albedoOpacitySample.a;
      opacity = float(1.0f);
    }
    else
    {
      opacity = albedoOpacitySample.a;
      thinFilmThickness = float(0.0f);
    }
  }

#if defined(RAY_TRACING_PRIMARY_RAY)
  if (shaderDebugView(cb.debugView) == DEBUG_VIEW_RAW_ALBEDO)
  {
    storeInDebugView(getDispatchRaysIndex().xy, albedo.xyz);
  }

  if (shaderDebugView(cb.debugView) == DEBUG_VIEW_OPAQUE_RAW_ALBEDO_RESOLUTION_CHECKERS)
  {
    storeColorOverlayedWithTextureResolutionCheckersInDebugView(albedo.xyz, opaqueSurfaceMaterial.albedoOpacityTextureIndex, surfaceInteraction);
  } 

  storeSamplerFeedback(opaqueSurfaceMaterial.samplerFeedbackStamp, surfaceInteraction);

#endif

  vec4 tFactor = unorm4x8ToFloat4x32(surface.tFactor).bgra;

  // WAR for REMIX-1573: texture ops for opacity should happen during baking and be skipped here for baked terrain,
  // but right now the opacity is not 1 in the baked texture where it is expected to be and thus texture ops
  // are required to blend the layer contributions properly 
#if 0
  if (applyTextureOperations) 
#endif
  {
    if (surface.isVertexColorBakedLighting) {
      // "Normalize" vertex color to remove lighting contribution in different vertices.
      // We assume the diffuse term contributes most lighting. Therefore, vertex color = diffuseColor * (N*L).
      // By dividing the vertex color by its largest component, the result is irrelavant to N*L, but proportional to the 
      // original diffuse color, which is more desired.
      // In practice, we add an adjustable blending factor to avoid extreme cases.
      surfaceInteraction.vertexColor.rgb = max(surfaceInteraction.vertexColor.rgb, vec3(1.0 / 255.0));
      float maxColor = max(surfaceInteraction.vertexColor.r, max(surfaceInteraction.vertexColor.g, surfaceInteraction.vertexColor.b));
      surfaceInteraction.vertexColor.rgb /= maxColor;
      surfaceInteraction.vertexColor.rgb = mix(vec3(1), surfaceInteraction.vertexColor.rgb, float(cb.vertexColorStrength));
    }

    vec4 vertexColorMask;
    if (surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.vertexColorMaskTextureIndex,
        opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, vertexColorMask, materialLodBias))
    {
      surfaceInteraction.vertexColor.rgb = mix(vec3(1.0f), surfaceInteraction.vertexColor.rgb, saturate(vertexColorMask.r));
    }

    // Fixed function texture stage setting
    vec3 textureArg1 = vec3(1.0), textureArg2 = vec3(1.0);
    chooseTextureArgument(textureArg1, surface.textureColorArg1Source, albedo, surfaceInteraction.vertexColor.rgb, tFactor.rgb, vec3(1.0));
    chooseTextureArgument(textureArg2, surface.textureColorArg2Source, albedo, surfaceInteraction.vertexColor.rgb, tFactor.rgb, vec3(1.0));
    chooseTextureOperationColor(albedo, surface.textureColorOperation, textureArg1, textureArg2);
    if (surface.isTextureFactorBlend) {
      albedo *= tFactor.rgb;
    }

    // Adjust opacity via texture operations.
    // Fixed function texture stage state for alpha channel

    opacity = surfaceTextureAlpha(surface, opacity, surfaceInteraction.vertexColor.a);
    
    // Ensure we perform these opacity calculations after the texture operations have been applied to abledo and alpha.
    calcOpaqueSurfaceMaterialOpacity(
      albedo, opacity, surface, opacity, emissiveBlendOverrideInfluence, cb.wboitEnabled);
  }

  if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IGNORE_ALPHA_CHANNEL)
  {
    opacity = 1.f;
  }
  
  // Note: Gamma correct albedo input (be it from a constant or a texture). Currently assuming all textures are not using sRGB formats which
  // automatically do this conversion.
  // Todo: Disable this for when a sRGB texture is the source of the albedo.
  albedo = gammaToLinear(albedo);

  // Apply material modifiers/overrides
  albedo = saturate(albedo * cb.opaqueMaterialArgs.albedoScale + cb.opaqueMaterialArgs.albedoBias);
  
  if (cb.opaqueMaterialArgs.enableThinFilmOverride)
  {
    // Note: Thickness override is already normalized to the proper 0-1 range by the CPU to match how the albedo texture alpha channel encodes thickness.
    thinFilmThickness = cb.opaqueMaterialArgs.thinFilmNormalizedThicknessOverride;
  }

  sample.albedo = albedo;
  sample.opacity = opacity;
  sample.emissiveBlendOverrideInfluence = emissiveBlendOverrideInfluence;
  sample.thinFilmThickness = thinFilmThickness;
  return sample;
}

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreatePrepared(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  Surface surface,
  inout SurfaceInteraction surfaceInteraction,
  MinimalRayInteraction minimalRayInteraction,
  OpaqueMaterialSample sample)
{
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;
  opaqueSurfaceMaterialInteraction.flags = sample.flags;
  const vec3 albedo = sample.albedo;
  const float opacity = sample.opacity;
  const float emissiveBlendOverrideInfluence = sample.emissiveBlendOverrideInfluence;
  const float thinFilmThickness = sample.thinFilmThickness;
  const bool isHairCardMaterial = opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IS_HAIR_CARD;
  const float materialLodBias = isHairCardMaterial ? cb.hairCardMipBias : 0.0f;
  const bool isBakedTerrain = surface.texcoordGenerationMode == uint(TexGenMode::CascadedViewPositions);
  const vec4 tFactor = unorm4x8ToFloat4x32(surface.tFactor).bgra;

  // Create a tangent to world space matrix for future calculations

  const f16mat3 worldToTangent = f16mat3(surfaceInteraction.geometryTangent, surfaceInteraction.geometryBitangent, surfaceInteraction.geometryNormal);

  // Sample from each Opaque Surface Material texture

  vec4 normalSample;
  vec4 secondNormalSample;
  vec4 roughnessSample;
  vec4 metallicSample;

  const bool normalLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.normalTextureIndex, opaqueSurfaceMaterial.reliefSamplerIndex, surfaceInteraction, normalSample, materialLodBias);

  bool secondNormalLoaded = false;
  if (cb.opaqueMaterialArgs.layeredWaterNormalEnable && surface.isAnimatedWater)
  {
    // take a second sample from a higher LOD using a modified texture xform
    const vec2 motionScale = vec2(cb.opaqueMaterialArgs.layeredWaterNormalMotionX, cb.opaqueMaterialArgs.layeredWaterNormalMotionY) * cb.opaqueMaterialArgs.layeredWaterNormalMotionScale;
    const float lodBias = cb.opaqueMaterialArgs.layeredWaterNormalLodBias;

    vec2 savedCoordinates = surfaceInteraction.textureCoordinates;
    surfaceInteraction.textureCoordinates = waterLayeredNormalUV(savedCoordinates, surface.textureTransform, motionScale);
    secondNormalLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.normalTextureIndex, opaqueSurfaceMaterial.reliefSamplerIndex, surfaceInteraction, secondNormalSample, lodBias);
    surfaceInteraction.textureCoordinates = savedCoordinates;
  }

  const bool roughnessLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.roughnessTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, roughnessSample, materialLodBias);
  const bool metallicLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.metallicTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, metallicSample, materialLodBias);

  // Load Normal

  vec3 normal = surfaceInteraction.geometryNormal;
  // Note: Defaults to 0 as this indicates no normal detail (which should be the case when a normal map is not present).
  float normalDetail = 0.0f;

  if (normalLoaded)
  {
    vec3 tangentNormal;

    // Terrain baker produces decoded tangentNormal and (first) normal.
    if (isBakedTerrain)  
    {
      // REMIX-2224: Normals blended during terrain baking using programmable shaders can sometimes end up being invalid so we sanitize them at this point
      tangentNormal = sanitize(normalSample.xyz, cb.isZUp ? vec3(0.f, 0.f, 1.f) : vec3(0.f, 1.f, 0.f));
    }
    else // Decode encoded normal sample
    {
      // Note: Using f16 from texture to decode from is fine as the original texture is only 8 bits of precision.
      tangentNormal = unsignedOctahedralToHemisphereDirection(vec2(normalSample.xy), cb.opaqueMaterialArgs.normalIntensity);
    }
    
    const f16mat3 tangentToWorld = transpose(worldToTangent);

    normal = normalize(mul(tangentToWorld, tangentNormal));

    // REMIX-2224: Normals blended during terrain baking using programmable shaders can sometimes end up being invalid
    // after being transformed to world space so we sanitize them here
    if (isBakedTerrain) {
      normal = sanitize(normal, cb.isZUp ? vec3(0.f, 0.f, 1.f) : vec3(0.f, 1.f, 0.f));
    }

    // Note: Only factoring in the initial normal map read as part of the normal map calculation as the second normal acts blends in worldspace which
    // would re-introduce the potential for precision issues that we're trying to avoid in this calculation. Additionally, the second normal is only used
    // currently for water effects and is sampled from a less detailed mip, so it is likely not too relevant for "detail" in the normal map with regards
    // to what the normal detail is used for (denoiser disocclusion threshold modifications).
    normalDetail = 1.0f - tangentNormal.z; // Note: 1 - n.z == 1 - dot(n, vec3(0, 0, 1))

    if (secondNormalLoaded)
    {
      vec3 tangentNormal2 = unsignedOctahedralToHemisphereDirection(vec2(secondNormalSample.xy), cb.opaqueMaterialArgs.normalIntensity);
      
      tangentNormal2 = normalBlendRNM(tangentNormal2, tangentNormal);
      normal = normalize(mul(tangentToWorld, tangentNormal2));

    }
  }
  
#if defined(RAY_TRACING_PRIMARY_RAY)
  if (shaderDebugView(cb.debugView) == DEBUG_VIEW_OPAQUE_NORMAL_RESOLUTION_CHECKERS)
  {
    storeColorOverlayedWithTextureResolutionCheckersInDebugView(normal, opaqueSurfaceMaterial.normalTextureIndex, surfaceInteraction);
  }
#endif
  // Load Roughness

  float roughness = opaqueSurfaceMaterial.roughnessConstant;

  if (roughnessLoaded)
  {
    roughness = roughnessSample.x;
  }

#if defined(RAY_TRACING_PRIMARY_RAY)
  if (shaderDebugView(cb.debugView) == DEBUG_VIEW_OPAQUE_ROUGHNESS_RESOLUTION_CHECKERS)
  {
    storeColorOverlayedWithTextureResolutionCheckersInDebugView(roughness.xxx, opaqueSurfaceMaterial.roughnessTextureIndex, surfaceInteraction);
  }
#endif  
  // Apply material modifiers
  const float roughnessScale = cb.opaqueMaterialArgs.roughnessScale * (isHairCardMaterial ? cb.hairCardRoughnessScale : 1.0f);
  roughness = saturate(roughness * roughnessScale + cb.opaqueMaterialArgs.roughnessBias);

  // Load Metallic

  float metallic = opaqueSurfaceMaterial.metallicConstant;

  if (metallicLoaded)
  {
    metallic = metallicSample.x;
  }
    
  metallic = saturate(metallic * cb.opaqueMaterialArgs.metallicScale + cb.opaqueMaterialArgs.metallicBias);

  // Transform to desired Opaque Material Interaction values

  opaqueSurfaceMaterialInteraction.shadingNormal = getBentNormal(surfaceInteraction.geometryNormal, normal, -minimalRayInteraction.viewDirection);
  opaqueSurfaceMaterialInteraction.normalDetail = normalDetail;
  // Todo: Shading tangent/bitangent for anisotropy?
  opaqueSurfaceMaterialInteraction.opacity = opacity;
  opaqueSurfaceMaterialInteraction.thinFilmThickness = thinFilmThickness;

  // Note: Opacity factored into albedo and base reflectivity to ensure NEE and indirect lighting off of objects with opacity properly
  // account for how much light is being transmitted due to the opacity (similar to how Fresnel on glass works).
  opaqueSurfaceMaterialInteraction.albedo = surface.isMatte ? vec3(0) : albedoToAdjustedAlbedo(albedo, metallic, opacity);
  opaqueSurfaceMaterialInteraction.baseReflectivity = surface.isMatte ? vec3(0) : calcBaseReflectivity(albedo, metallic, opacity);
   
  // Note: Roughness loaded from texture is a perceptual roughness value (for optimal encoding), so this works as intended.
  calcRoughness(roughness, opaqueSurfaceMaterial.anisotropy,
    opaqueSurfaceMaterialInteraction.isotropicRoughness,
    opaqueSurfaceMaterialInteraction.anisotropicRoughness);

  // Load Emissive Color
  // Note: Surfaces without an emissive intensity do not read their emissive texture or apply its texture stage operations.

  vec3 emissiveRadiance = vec3(0.0f);

  if (opaqueSurfaceMaterial.emissiveIntensity != 0.0)
  {
    if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IS_END_PORTAL)
    {
      opaqueSurfaceMaterialInteraction.albedo = vec3(0.0f);
      opaqueSurfaceMaterialInteraction.baseReflectivity = vec3(0.0f);
      if (opaqueSurfaceMaterial.secondaryTextureIndex != BINDING_INDEX_INVALID &&
          opaqueSurfaceMaterial.emissiveColorTextureIndex != BINDING_INDEX_INVALID)
      {
        const uint layerCount = (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IS_END_GATEWAY) ? 16u : 15u;
        emissiveRadiance = endPortalEmission(
          textures[nonuniformEXT(uint(opaqueSurfaceMaterial.secondaryTextureIndex))],
          textures[nonuniformEXT(uint(opaqueSurfaceMaterial.emissiveColorTextureIndex))],
          samplers[nonuniformEXT(uint(opaqueSurfaceMaterial.samplerIndex))],
          cb.camera.translatedWorldToProjectionJittered, cb.camera.resolution, cb.timeSinceStartSeconds,
          minimalRayInteraction.viewDirection, layerCount, opaqueSurfaceMaterial.emissiveIntensity);
      }
    }
    else
    {
      vec4 emissiveColorSample;
      const bool emissiveColorLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.emissiveColorTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, emissiveColorSample, materialLodBias);

      vec3 emissiveColor = opaqueSurfaceMaterial.emissiveColorConstant;

      if (emissiveColorLoaded)
      {
        emissiveColor = emissiveColorSample.xyz;
      }

      // Fixed function texture stage setting (emissive)
      vec3 textureArg1 = vec3(1.0);
      vec3 textureArg2 = vec3(1.0);
      chooseTextureArgument(textureArg1, surface.textureColorArg1Source, emissiveColor, surfaceInteraction.vertexColor.rgb, tFactor.rgb, vec3(1.0));
      chooseTextureArgument(textureArg2, surface.textureColorArg2Source, emissiveColor, surfaceInteraction.vertexColor.rgb, tFactor.rgb, vec3(1.0));
      chooseTextureOperationColor(emissiveColor, surface.textureColorOperation, textureArg1, textureArg2);
      if (surface.isTextureFactorBlend) {
        emissiveColor *= tFactor.rgb;
      }

      // Note: Gamma correct emissive color input (be it from a constant or a texture). Currently assuming all textures are not using sRGB formats which
      // automatically do this conversion.
      // Todo: Disable this for when a sRGB texture is the source of the emissive color.
      emissiveColor = gammaToLinear(emissiveColor);

      emissiveRadiance = emissiveBlendOverrideInfluence * emissiveColor * opaqueSurfaceMaterial.emissiveIntensity;
    }
  }

  if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_GLINT_MODE_MASK)
  {
    const float strength = cb.opaqueMaterialArgs.glintStrength;
    if (!(strength <= 0.f))
    {
      const uint mode = (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_GLINT_MODE_MASK) >> OPAQUE_SURFACE_MATERIAL_GLINT_MODE_SHIFT;
      const float scale = mode == OPAQUE_SURFACE_MATERIAL_GLINT_MODE_ITEM ? 8.f :
        (mode == OPAQUE_SURFACE_MATERIAL_GLINT_MODE_ENTITY ? 0.5f : 0.16f);
      emissiveRadiance += surfaceGlint(textures[nonuniformEXT(uint(opaqueSurfaceMaterial.glintTextureIndex))],
        samplers[nonuniformEXT(uint(opaqueSurfaceMaterial.samplerIndex))],
        surfaceInteraction.textureCoordinates, surfaceInteraction.textureGradientX, surfaceInteraction.textureGradientY,
        albedo, materialLodBias, strength, cb.timeSinceStartSeconds, cb.opaqueMaterialArgs.glintSpeed, scale);
    }
  }
  opaqueSurfaceMaterialInteraction.emissiveRadiance = emissiveRadiance;

  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction =
    subSurfaceMaterialReadHelper(opaqueSurfaceMaterial.subsurfaceMaterialIndex, surfaceInteraction, opaqueSurfaceMaterial.samplerIndex);
  opaqueSurfaceMaterialInteraction.dlssControlMask = opaqueSurfaceMaterial.dlssControlMask;

  // For an eye, load a secondary texture (iris) and blend on top of primary texture (whites)
  if (cb.eyeArgs.enableEyes && surface.isEye)
  {
    vec2 irisParallaxOffset;
    const bool irisVisible = eyeCalcParallaxOffset(
      surface.eyeBasisU, surface.eyeBasisV, surface.eyeOrigin, surfaceInteraction.position,
      minimalRayInteraction.viewDirection, cb.eyeArgs.irisRadius + 0.04, surface.eyeCorrectionIndex, irisParallaxOffset);
    float viewCosine = abs(dot(minimalRayInteraction.viewDirection, normalize(cross(surface.eyeBasisU, surface.eyeBasisV))));
    if (surface.eyeCorrectionIndex != 0)
    {
      // Without the view model correction, as in eyeCalcParallaxOffset.
      const float3x3 toShading = cb.eyeArgs.corrections[surface.eyeCorrectionIndex - 1].worldToShading;
      viewCosine = abs(dot(normalize(mul(toShading, minimalRayInteraction.viewDirection)),
        normalize(mul(toShading, cross(surface.eyeBasisU, surface.eyeBasisV)))));
    }
    overrideMaterialInteractionForEye(
      opaqueSurfaceMaterialInteraction,
      opaqueSurfaceMaterial,
      surfaceInteraction,
      irisParallaxOffset,
      irisVisible,
      viewCosine,
      albedo
    );
  }

  return opaqueSurfaceMaterialInteraction;
}

// Visibility rays can omit the parallax-displaced texture coordinates.
OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreateImpl<let EnablePom : bool>(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  Surface surface,
  inout SurfaceInteraction surfaceInteraction,
  MinimalRayInteraction minimalRayInteraction)
{
  const OpaqueMaterialSample sample = opaqueSurfaceMaterialPrepare<EnablePom>(
    opaqueSurfaceMaterial, surface, surfaceInteraction, minimalRayInteraction);
  return opaqueSurfaceMaterialInteractionCreatePrepared(
    opaqueSurfaceMaterial, surface, surfaceInteraction, minimalRayInteraction, sample);
}

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  Surface surface,
  inout SurfaceInteraction surfaceInteraction,
  MinimalRayInteraction minimalRayInteraction)
{
  return opaqueSurfaceMaterialInteractionCreateImpl<true>(opaqueSurfaceMaterial, surface, surfaceInteraction, minimalRayInteraction);
}

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction)
{
  // Decode the Opaque Surface Material Interaction from its polymorphic representation
  // Note: Opaque type is known in advance

  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;

  opaqueSurfaceMaterialInteraction.shadingNormal = polymorphicSurfaceMaterialInteraction.shadingNormal;
  opaqueSurfaceMaterialInteraction.emissiveRadiance = polymorphicSurfaceMaterialInteraction.emissiveRadiance;
  opaqueSurfaceMaterialInteraction.albedo = polymorphicSurfaceMaterialInteraction.vdata0;
  opaqueSurfaceMaterialInteraction.baseReflectivity = polymorphicSurfaceMaterialInteraction.vdata1;

  if (polymorphicSurfaceMaterialInteraction.fdata0 < 0.0)
  {
    opaqueSurfaceMaterialInteraction.opacity = 1.0;
    opaqueSurfaceMaterialInteraction.thinFilmThickness = -polymorphicSurfaceMaterialInteraction.fdata0;
  }
  else
  {
    opaqueSurfaceMaterialInteraction.opacity = polymorphicSurfaceMaterialInteraction.fdata0;
    opaqueSurfaceMaterialInteraction.thinFilmThickness = 0.0;
  }
  
  opaqueSurfaceMaterialInteraction.isotropicRoughness = polymorphicSurfaceMaterialInteraction.fdata1;
  opaqueSurfaceMaterialInteraction.anisotropicRoughness.x = polymorphicSurfaceMaterialInteraction.fdata2;
  opaqueSurfaceMaterialInteraction.anisotropicRoughness.y = polymorphicSurfaceMaterialInteraction.fdata3;
  opaqueSurfaceMaterialInteraction.normalDetail = polymorphicSurfaceMaterialInteraction.fdata4;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.measurementDistance = polymorphicSurfaceMaterialInteraction.fdata5;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.volumetricAnisotropy = polymorphicSurfaceMaterialInteraction.bdata1;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.maxSampleRadius = polymorphicSurfaceMaterialInteraction.bdata2;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.packedTransmittanceColor = polymorphicSurfaceMaterialInteraction.i32data0;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = polymorphicSurfaceMaterialInteraction.i32data1;

  opaqueSurfaceMaterialInteraction.dlssControlMask = polymorphicSurfaceMaterialInteraction.dlssControlMask;
  opaqueSurfaceMaterialInteraction.flags = polymorphicSurfaceMaterialInteraction.bdata0;

  return opaqueSurfaceMaterialInteraction;
}

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(
  GBufferMemoryPolymorphicSurfaceMaterialInteraction gBufferMemoryPolymorphicSurfaceMaterialInteraction)
{
  // Decode the Opaque Surface Material Interaction from its polymorphic GBuffer Memory representation
  // Note: Opaque type is known in advance

  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;

  const uint data0 = gBufferMemoryPolymorphicSurfaceMaterialInteraction.data0;
  const uint data1 = gBufferMemoryPolymorphicSurfaceMaterialInteraction.data1;

  const float perceptualRoughness = gBufferMemoryPolymorphicSurfaceMaterialInteraction.perceptualRoughness;
  const float sourceAnisotropy = snorm8ToF16(uint8_t(data0 >> 0));
  const float opacityOrThinFilmThickness = unorm8ToF16(uint8_t(data0 >> 8));
  const uint8_t flagsAndType = uint8_t(data0 >> 24);
  const vec3 gammaEmissiveColor = vec3(
    unorm8ToF32(uint8_t(data0 >> 16)),
    unorm8ToF32(uint8_t(data1 >> 0)),
    unorm8ToF32(uint8_t(data1 >> 8)));
  const vec3 emissiveColor = gammaToLinearFast(gammaEmissiveColor);
  const float emissiveIntensity = uint16BitsToF32(uint16_t(data1 >> 16));

  float isotropicRoughness;
  vec2 anisotropicRoughness;

  opaqueSurfaceMaterialInteraction.flags = flagsAndType & OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_MASK;
  const bool thinFilmEnabled = (flagsAndType & OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_USE_THIN_FILM_LAYER);

  calcRoughness(perceptualRoughness, sourceAnisotropy, isotropicRoughness, anisotropicRoughness);

  opaqueSurfaceMaterialInteraction.shadingNormal = gBufferMemoryPolymorphicSurfaceMaterialInteraction.worldShadingNormal;

  opaqueSurfaceMaterialInteraction.albedo = gBufferMemoryPolymorphicSurfaceMaterialInteraction.albedo;
  // Note: Opacity set to 1 when thin film is enabled (as we unfortunately cannot read from the opacity constant here and there
  // is no extra room in this GBuffer encoding to store both the opacity and the thin film thickness).
  opaqueSurfaceMaterialInteraction.opacity = thinFilmEnabled ? float(1.0f) : opacityOrThinFilmThickness;
  opaqueSurfaceMaterialInteraction.baseReflectivity = gBufferMemoryPolymorphicSurfaceMaterialInteraction.baseReflectivity;
  opaqueSurfaceMaterialInteraction.isotropicRoughness = isotropicRoughness;
  opaqueSurfaceMaterialInteraction.anisotropicRoughness = anisotropicRoughness;
  opaqueSurfaceMaterialInteraction.emissiveRadiance = emissiveColor * emissiveIntensity;
  // Note: Thickness set to 0 when thin film is disabled for the same reason the opacity is set to 1 when it is enabled.
  opaqueSurfaceMaterialInteraction.thinFilmThickness = thinFilmEnabled ? opacityOrThinFilmThickness : float(0.0f);

  // We don't store this in the G-buffer
  opaqueSurfaceMaterialInteraction.normalDetail = float(0.0f);
  opaqueSurfaceMaterialInteraction.dlssControlMask = float4x32ToUnorm4x8(1.0f.rrrr);

  // Note thin opaque properties are stored later into PolymorphicSurfaceMaterialInteraction

  return opaqueSurfaceMaterialInteraction;
}

[ForceInline]
OpaqueLobeSampling opaqueLobeSampling(RaytraceArgs args)
{
  return {
    { uint16BitsToF32(args.opaqueDiffuseLobeSamplingProbabilityZeroThreshold),
      uint16BitsToF32(args.minOpaqueDiffuseLobeSamplingProbability) },
    { uint16BitsToF32(args.opaqueSpecularLobeSamplingProbabilityZeroThreshold),
      uint16BitsToF32(args.minOpaqueSpecularLobeSamplingProbability) },
    { uint16BitsToF32(args.opaqueOpacityTransmissionLobeSamplingProbabilityZeroThreshold),
      uint16BitsToF32(args.minOpaqueOpacityTransmissionLobeSamplingProbability) },
    { uint16BitsToF32(args.opaqueDiffuseTransmissionLobeSamplingProbabilityZeroThreshold),
      uint16BitsToF32(args.minOpaqueDiffuseTransmissionLobeSamplingProbability) }
  };
}

#ifdef OPAQUE_MATERIAL_USE_THIN_FILM
static const bool kOpaqueThinFilm = true;
#else
static const bool kOpaqueThinFilm = false;
#endif

void opaqueSurfaceMaterialInteractionCalcSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  OpaqueLobeSampling lobeSampling,
  float lobeRandom,
  inout RNG randomState,
  vec4 tangentToWorldSpaceQuaternion,
  vec3 viewDirection,
  inout SurfaceMaterialInteractionSample surfaceMaterialInteractionSample,
  inout SurfaceMaterialInteractionLobeSample surfaceMaterialInteractionLobeSample,
  inout bool insideMedium, inout bool penetrateSurface)
{
  surfaceMaterialInteractionLobeSample = opaqueSurfaceMaterialInteractionCalcLobeSample(
    opaqueSurfaceMaterialInteraction, lobeRandom, viewDirection, lobeSampling);

  switch (uint(surfaceMaterialInteractionLobeSample.lobe))
  {
  default:
  case uint(opaqueLobeTypeDiffuseReflection):
    surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcDiffuseReflectionSample(
      opaqueSurfaceMaterialInteraction, vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState)),
      tangentToWorldSpaceQuaternion, viewDirection);

    break;
  case uint(opaqueLobeTypeSpecularReflection):
    surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcSpecularReflectionSample<kOpaqueThinFilm>(
      opaqueSurfaceMaterialInteraction, vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState)),
      tangentToWorldSpaceQuaternion, viewDirection);

    break;
  case uint(opaqueLobeTypeOpacityTransmission):
    surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcOpacityTransmissionSample(
      opaqueSurfaceMaterialInteraction, viewDirection, insideMedium, penetrateSurface);

    break;
  case uint(opaqueLobeTypeDiffuseTransmission):
    // Load Subsurface Material
    const SubsurfaceMaterial subsurfaceMaterial = decodeSubsurfaceMaterial(opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction);

    // When the thickness of surface is thinner than this experimental threshold, we don't need to consider the volume of the surface.
    // Instead, we use a cheaper 2-side sampling method with traditional LambertBTDF to simulate the effect.
    if (subsurfaceMaterial.measurementDistance > 0.05f)
    {
      surfaceMaterialInteractionSample = thinOpaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSample(
        opaqueSurfaceMaterialInteraction, vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState)),
        tangentToWorldSpaceQuaternion, viewDirection, subsurfaceMaterial, insideMedium, penetrateSurface);
    }
    else
    {
      surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSample(
        opaqueSurfaceMaterialInteraction, vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState)),
        tangentToWorldSpaceQuaternion, viewDirection, insideMedium, penetrateSurface);
    }

    break;
  }
}

[ForceInline]
SurfaceMaterialInteractionSplitWeight opaqueSurfaceMaterialInteractionCalcProjectedWeight(
  OpaqueSurfaceMaterialInteraction material, MinimalRayInteraction hit, vec3 inputDirection)
{
  return opaqueProjectedWeight<kOpaqueThinFilm>(material, hit.viewDirection, inputDirection);
}

[ForceInline]
SurfaceMaterialInteractionSplitWeight opaqueSurfaceMaterialInteractionCalcProjectedWeight(
  OpaqueSurfaceMaterialInteraction material, OpaqueTangentFrame tangentFrame)
{
  return opaqueProjectedWeight<kOpaqueThinFilm>(material, tangentFrame);
}

vec3 opaqueSurfaceMaterialInteractionEvalEmissiveRadiance(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  return opaqueSurfaceMaterialInteraction.emissiveRadiance;
}

vec3 opaqueSurfaceMaterialGetAdjustedBaseReflectivity(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  // Note: Simple max taken between the specular reflection base reflectivity and a monochromatic "transmission" factor
  // based on the opacity to ensure if any contribution is in the specular lobe it will be properly represented.
  const vec3 adjustedBaseReflectivity = max(
    opaqueSurfaceMaterialInteraction.baseReflectivity,
    vec3(float(1.0f) - opaqueSurfaceMaterialInteraction.opacity));

  return adjustedBaseReflectivity;
}

bool opaqueSurfaceMaterialInteractionHasHeightTexture(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  return opaqueSurfaceMaterialInteraction.flags & OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_HAS_HEIGHT_TEXTURE;
}
