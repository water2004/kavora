#pragma once

#include "rtx/concept/surface_material/surface_material.h"
#include "rtx/concept/surface_material/translucent_medium.slangh"
#include "rtx/utility/brdf.slangh"

// Interface optics shared by BSDF sampling and primary surface replacement.
bool translucentSurfaceMaterialInteractionIsThinWalled(
  TranslucentSurfaceMaterialInteraction translucentSurfaceMaterialInteraction)
{
  return translucentSurfaceMaterialInteraction.thicknessOrMeasurementDistance < 0.0f;
}

float translucentSurfaceMaterialInteractionGetThinWallThickness(
  TranslucentSurfaceMaterialInteraction translucentSurfaceMaterialInteraction)
{
  return -translucentSurfaceMaterialInteraction.thicknessOrMeasurementDistance;
}

struct TranslucentInterface
{
  uint exteriorMedium;
  bool exiting;
  bool thin;
  float eta;
  float baseReflectivity;
};

// Thick faces delimit their material and their declared exterior. Thin sheets keep the incident medium.
TranslucentInterface translucentInterface(TranslucentSurfaceMaterialInteraction material, uint medium)
{
  TranslucentInterface boundary;
  boundary.thin = translucentSurfaceMaterialInteractionIsThinWalled(material);
  boundary.exteriorMedium = (material.flags & TRANSLUCENT_SURFACE_MATERIAL_FLAG_WATER_CONTACT)
    ? cb.waterMediumMaterialIndex : SURFACE_INDEX_INVALID;
  boundary.exiting = !boundary.thin && medium != SURFACE_INDEX_INVALID && medium != boundary.exteriorMedium;

  const uint exteriorMedium = boundary.thin ? medium : boundary.exteriorMedium;
  const float exteriorIor = exteriorMedium == cb.waterMediumMaterialIndex && exteriorMedium != SURFACE_INDEX_INVALID
    ? float(translucentSurfaceMaterialCreate(surfaceMaterials[exteriorMedium]).refractiveIndex) : materialIoRVacuum;
  const float ratio = exteriorIor / material.refractiveIndex;
  boundary.eta = boundary.exiting ? rcp(ratio) : ratio;
  boundary.baseReflectivity = material.baseReflectivity;
  if (exteriorIor != materialIoRVacuum) {
    const float vacuumReflectivity = square((material.refractiveIndex - 1.0f) / (material.refractiveIndex + 1.0f));
    boundary.baseReflectivity = saturate(boundary.baseReflectivity + square((1.0f - ratio) / (1.0f + ratio)) - vacuumReflectivity);
  }
  return boundary;
}

uint translucentTransmittedMedium(TranslucentSurfaceMaterialInteraction material, TranslucentInterface boundary)
{
  if (boundary.exiting) return boundary.exteriorMedium;
  if ((material.flags & TRANSLUCENT_SURFACE_MATERIAL_FLAG_SIMULATED_WATER) &&
      cb.waterMediumMaterialIndex != SURFACE_INDEX_INVALID) return cb.waterMediumMaterialIndex;
  return translucentMediumEnter(material);
}

// Thin sheets use transmittance measured over one world unit.
[ForceInline]
vec3 thinWallTransmittance(vec3 transmittanceColor, float thickness, vec3 normal, vec3 direction)
{
  const float distance = evalThinAttenuationDistance(thickness, normal, direction);
  const vec3 extinction = transmittanceToAttenuationCoefficient(transmittanceColor, 1.0);
  return evalBeerLambertAttenuation(extinction, distance);
}
