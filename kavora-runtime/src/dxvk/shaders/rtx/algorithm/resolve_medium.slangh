#pragma once

#include "rtx/concept/surface_material/translucent_medium.slangh"
#include "rtx/algorithm/atmosphere.slangh"
#include "rtx/algorithm/environment_radiance.slangh"

// Tracks the current thick medium across transmission events. Nested media are unsupported.
bool evalMediumChange(bool wasInside, bool isInside, PolymorphicSurfaceMaterialInteraction interaction,
  inout uint mediumState)
{
  if (wasInside == isInside)
  {
    return false;
  }

  mediumState = isInside
    ? translucentMediumEnter(translucentSurfaceMaterialInteractionCreate(interaction))
    : SURFACE_INDEX_INVALID;
  return true;
}

// Applies one ray segment to its incoming throughput and emitted radiance.
// Each resolver variant chooses the existing atmosphere implementation.
#ifdef RESOLVER_USE_VOLUMETRIC_ATTENUATION
#ifdef RESOLVER_PRECOMPUTED_PRIMARY_ATMOSPHERE
#include "rtx/pass/gbuffer/primary_atmosphere.slangh"
#endif
#ifdef RESOLVER_ATMOSPHERE_CALLABLE
#include "rtx/pass/gbuffer/atmosphere_call.slangh"
#endif

void resolveAtmosphere(float3 origin, float3 direction, float distance, uint volumeHint,
  inout float3 attenuation, inout float3 radiance, uint mediumState = SURFACE_INDEX_INVALID)
{
  const float3 mediumExtinction = translucentMediumExtinction(mediumState);
  if (!cb.volumeArgs.enable && !cb.volumeArgs.clouds.enable)
  {
    attenuation *= volumeTransmittance(mediumExtinction, distance);
    return;
  }
#ifdef RESOLVER_ATMOSPHERE_CALLABLE
  AtmosphereCallData data;
  data.origin = origin;
  data.direction = direction;
  data.distance = distance;
  data.volumeHint = volumeHint;
  data.mediumExtinction = mediumExtinction;
  CallShader(0, data);
  const AtmosphereSegment segment = { data.radiance, data.transmittance };
#else
  float3 ambient = cb.volumeArgs.clouds.enable
    ? sampleEnvironmentRadiance(cb.domeLightArgs, cb.skyBrightness, SkyProbe, LinearWrapSampler, cb.volumeArgs.sceneUpDirection) * 0.5f
    : float3(0);
  AtmosphereSegment segment = integrateAtmosphereSegment(cb.volumeArgs, VolumeFilteredRadianceY,
    VolumeFilteredRadianceCoCg, origin, direction, distance, ambient, volumeHint, mediumExtinction);
#endif
  radiance += attenuation * segment.radiance;
  attenuation *= segment.transmittance;
}
#endif
