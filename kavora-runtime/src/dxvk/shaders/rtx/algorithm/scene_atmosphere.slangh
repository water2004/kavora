#pragma once

#include "rtx/algorithm/scene_air.slangh"
#include "rtx/algorithm/scene_cloud_lighting.slangh"
#include "rtx/algorithm/environment_radiance.slangh"
#include "rtx/algorithm/volume_lighting.slangh"
import "rtx/concept/camera/camera.slang";
import "rtx/algorithm/clouds.slang";
import "rtx/algorithm/cloud_sky.slang";

// The cached tail starts on a sphere about the camera. Project the new
// direction through the nearest remaining cloud shell, and bound the error
// at the ends of the cached cloud range by the bilinear sampling footprint.
bool findSharedAtmosphereTail(VolumeArgs volume, AtmosphereRay ray, float distance, uint volumeHint,
  out float begin, out float2 uv, out float2 depthProjection)
{
  begin = 0;
  uv = 0;
  depthProjection = 0;
  if (distance != floatMax || volumeHint != 0
      || !ray.hasCloud || any(ray.mediumExtinction > 0))
  {
    return false;
  }
  const float3 relative = ray.origin - cameraGetWorldPosition(cb.camera);
  const float along = dot(relative, ray.direction);
  const float3 lateral = relative - along * ray.direction;
  const float lateralSquared = dot(lateral, lateral);
  const float radius = cloudSkyTailStart(volume);
  const float cutSquared = radius * radius - lateralSquared;
  if (cutSquared <= 0)
  {
    return false;
  }
  begin = sqrt(cutSquared) - along;
  if (begin <= 0 || ray.intervals.ends[0] > begin)
  {
    return false;
  }
  float2 firstCloud = floatMax;
  float lastCloud = begin;
  [unroll]
  for (uint i = 1; i <= 4; i++)
  {
    const float end = ray.intervals.ends[i];
    const float start = max(ray.intervals.starts[i], begin);
    if (end > start)
    {
      if (start < firstCloud.x)
      {
        firstCloud = float2(start, end);
      }
      lastCloud = max(lastCloud, end);
    }
  }
  if (firstCloud.y <= firstCloud.x)
  {
    return false;
  }
  const float focus = 0.5f * (firstCloud.x + firstCloud.y);
  const float inverseFocus = rcp(focus + along);
  const float error = max(rcp(firstCloud.x + along) - inverseFocus, inverseFocus - rcp(lastCloud + along));
  const float footprint = 2.0f * kCloudSkyTexelAngle;
  if (lateralSquared * error * error > footprint * footprint)
  {
    return false;
  }
  const float3 cacheDirection = normalize(lateral + (focus + along) * ray.direction);
  uv = cloudSkyUv(volume.clouds, cacheDirection);
  depthProjection = float2(dot(cacheDirection, ray.direction), along / cloudMaxViewDistance(volume.clouds));
  return true;
}

AtmosphereSegment resolveSceneAtmosphere(float3 origin, float3 direction, float distance, uint volumeHint,
  float3 mediumExtinction, bool allowFarTail)
{
  const VolumeArgs volume = cb.volumeArgs;
  const AtmosphereRay ray = createAtmosphereRay<SceneAtmosphereFog>(volume, origin, direction,
    volumeHint, mediumExtinction);
  const float3 ambient = ray.hasCloud ? sampleCloudAmbientRadiance(volume.clouds) : float3(0);
  float cachedBegin;
  float2 cachedUV;
  float2 cachedDepthProjection;
  const bool useTail = allowFarTail && findSharedAtmosphereTail(volume, ray, distance, volumeHint,
    cachedBegin, cachedUV, cachedDepthProjection);
  AtmosphereSegment transfer = integrateAtmosphereRange<SceneAtmosphereFog>(volume, VolumeFilteredRadianceY,
    VolumeFilteredRadianceCoCg, CloudWeatherSampler, CloudBaseSampler, CloudDetailSampler,
    sceneCloudLightingCache(), ray, 0, useTail ? cachedBegin : distance, ambient, sceneAirTables(volume.air, LinearWrapSampler));
  // An opaque prefix has already reached the integral's cutoff. Appending the
  // cached cloud moments here could attribute motion to a cloud behind it.
  if (useTail && any(transfer.transmittance >= kOpaqueCloudTransmittance))
  {
    const float4 radiance = CloudSkySampler.SampleLevel(float3(cachedUV, kCloudSkyTailRadianceLayer), 0);
    const float4 transmittance = CloudSkySampler.SampleLevel(float3(cachedUV, kCloudSkyTailTransmittanceLayer), 0);
    const float firstMoment = max(0.0f, transmittance.w * cachedDepthProjection.x - radiance.w * cachedDepthProjection.y);
    AtmosphereSegment tail = { radiance.xyz, transmittance.xyz, float2(firstMoment, radiance.w) };
    transfer = composeAtmosphereSegments(transfer, tail);
  }
  return transfer;
}
