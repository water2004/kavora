{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "provides": ["rtxremix-far-terrain-v1"],
    "version": "${version}",
    "name": "RTX Remix for Minecraft",
    "description": "Renders Minecraft through NVIDIA RTX Remix path tracing. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA"
    ],
    "contact": {
        "homepage": "https://github.com/water2004/rtx-remix-minecraft",
        "sources": "https://github.com/water2004/rtx-remix-minecraft",
        "issues": "https://github.com/water2004/rtx-remix-minecraft/issues"
    },
    "license": ["Apache-2.0", "LGPL-3.0-only"],
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ],
        "sodium:config_api_user": [
            "com.nvidia.rtxremix.minecraft.settings.RtxSodiumConfig"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json",
        "rtx-remix-sodium.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.20.1",
        "fabric-api": ">=0.165.0+26.3",
        "sodium": "0.9.2",
        "minecraft": "26.3",
        "java": ">=25"
    },
    "breaks": {
        "voxy": "*"
    }
}
